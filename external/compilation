#!/bin/bash -e
### Compile third-party libraries that ship their own build system.
### Sourced by .makefile/assets/scripts/compile-external-libs.sh from the
### external/ folder, which provides print-compile, call-cmake and NPROC.

###############################################################################
### rapidyaml: YAML backend of BlackThorn. Built as a static PIC archive so it
### can be linked into librobotik-core.so without polluting the system.
RYML_DIR="rapidyaml"
print-compile $RYML_DIR

if [ ! -f "$RYML_DIR/ext/c4core/CMakeLists.txt" ]; then
    (cd "$RYML_DIR" && git submodule update --init --recursive)
fi

call-cmake -S "$RYML_DIR" -B "$RYML_DIR/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DRYML_BUILD_SHARED_LIBS=OFF \
    -DRYML_BUILD_TESTS=OFF \
    -DRYML_BUILD_BENCHMARKS=OFF \
    -DRYML_BUILD_API=OFF

call-cmake --build "$RYML_DIR/build" --target ryml -j"$NPROC"

###############################################################################
### Compages, static and position-independent, so it can be linked into
### librobotik-core.so. The archive is private to this tree: the system
### libCompages.so is not used.
print-compile Compages
(cd Compages && make download-external-libs && \
    make COMPILATION_MODE=release -j"$NPROC" build/libCompages.a)

###############################################################################
### Pinocchio (analytical FK, Jacobians, IK) and MuJoCo (dynamics).
### They are not practical to build from a bare git clone here: Pinocchio needs
### Boost and urdfdom, which are not assumed to be installed. A user-local
### conda-forge prefix avoids sudo and stays inside external/ (gitignored).
FORGE_DIR="forge"
PINOCCHIO_PC="$(find "$FORGE_DIR" -path '*/pkgconfig/pinocchio.pc' -print -quit 2>/dev/null || true)"
MUJOCO_LIB="$(find "$FORGE_DIR" -name 'libmujoco.so*' -print -quit 2>/dev/null || true)"

if [ -z "$PINOCCHIO_PC" ] || [ -z "$MUJOCO_LIB" ]; then
    print-compile "pinocchio+mujoco"
    MAMBA_ROOT=".micromamba"
    mkdir -p "$MAMBA_ROOT"
    if [ ! -x "$MAMBA_ROOT/bin/micromamba" ]; then
        curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
            | tar -xj -C "$MAMBA_ROOT" bin/micromamba
    fi
    "$MAMBA_ROOT/bin/micromamba" create -y -p "$FORGE_DIR" -c conda-forge \
        pinocchio mujoco
fi

###############################################################################
### AprilTag: fiducial detection for the LineFollower demo. Static PIC archive,
### private to this tree.
APRILTAG_DIR="apriltag"
print-compile $APRILTAG_DIR
call-cmake -S "$APRILTAG_DIR" -B "$APRILTAG_DIR/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_PYTHON_WRAPPER=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF
call-cmake --build "$APRILTAG_DIR/build" --target apriltag -j"$NPROC"

###############################################################################
### Drosophila brain (Shiu et al. 2024). The clone vendors the FlyWire tables.
### Write the public v783 edge list into data/flywire. Those files are
### gitignored: the parquet alone is about 100 MB, the edge list is larger.
FLY_SRC="Drosophila_brain_model"
FLY_DATA="../data/flywire"
FLY_CON="$FLY_SRC/Connectivity_783.parquet"
FLY_COMP="$FLY_SRC/Completeness_783.csv"
print-compile "flywire connectome"
if [ ! -f "$FLY_CON" ] || [ ! -f "$FLY_COMP" ]; then
    echo "Missing $FLY_CON or $FLY_COMP. Run make download-external-libs first."
    exit 1
fi
mkdir -p "$FLY_DATA"
if [ ! -f "$FLY_DATA/edges.csv" ] || [ "$FLY_CON" -nt "$FLY_DATA/edges.csv" ]; then
    FLY_PY=".pydeps"
    if ! PYTHONPATH="$FLY_PY" python3 -c "import pyarrow" 2>/dev/null; then
        python3 -m pip install --target "$FLY_PY" pyarrow
    fi
    PYTHONPATH="$FLY_PY${PYTHONPATH:+:$PYTHONPATH}" \
        python3 ../src/Applications/Demos/FlyBrain/prepare_edges.py \
            "$FLY_CON" "$FLY_COMP" "$FLY_DATA/edges.csv"
    cp -f "$FLY_COMP" "$FLY_DATA/completeness.csv"
fi
