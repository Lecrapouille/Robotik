PROJECT_NAME := Robotik
PROJECT_VERSION := 0.2.0
COMPILATION_MODE := debug
CXX_STANDARD := --std=c++20

###############################################################################
# Third-party sources. external/manifest lists those of the core; a plugin
# lists its own in the dependencies of its plugin.yaml (see
# plugins/plugin.mk) and they are cloned into plugins/<Name>/external. Inside a plugin Makefile, THIRD_PARTIES_DIR is therefore the
# plugin's folder and ROBOTIK_EXTERNAL the one of the core. Nothing has a
# compilation script: each library is built by a Make rule, on demand.
ROBOTIK_EXTERNAL := $(abspath $(P)/external)
THIRD_PARTIES_FOLDER_NAME = $(if $(PLUGIN_NAME),plugins/$(PLUGIN_NAME)/external,external)

###############################################################################
# Pinocchio and MuJoCo live in a user-local prefix created by
# make download-external-libs (see the Makefile). pkg-config must see it
# before any dependency line below.
FORGE_PKGCONFIG := $(shell find $(P)/external/forge -type d -name pkgconfig 2>/dev/null | paste -sd: -)
ifneq ($(strip $(FORGE_PKGCONFIG)),)
export PKG_CONFIG_PATH := $(FORGE_PKGCONFIG):$(PKG_CONFIG_PATH)
endif

###############################################################################
# Eigen is header-only and is pulled here rather than through PKG_LIBS, which
# feeds -I: under it Eigen 5 emits more than a thousand -Wdeprecated warnings
# against the strict warning set. -isystem quiets the headers of the library
# without weakening the diagnostics on our own code. Keeping Eigen out of
# PKG_LIBS also stops a missing Eigen from making pkg-config fail as a whole,
# which used to silently drop the flags of every other dependency.
#
EIGEN_CFLAGS := $(shell pkg-config --cflags eigen3 2> /dev/null)
# The conda-forge Pinocchio was built against its own Eigen. Mixing it with
# the system Eigen breaks the Model ABI, so the forge copy wins when present.
ifneq ($(wildcard $(P)/external/forge/include/eigen3/Eigen/Core),)
EIGEN_CFLAGS := -I$(abspath $(P)/external/forge/include/eigen3)
endif
ifeq ($(strip $(EIGEN_CFLAGS)),)
$(warning Eigen3 not found by pkg-config: see the Prerequisites section of README.md)
endif
USER_CXXFLAGS += $(patsubst -I%,-isystem %,$(EIGEN_CFLAGS))

###############################################################################
# Compages is built from external/Compages and linked as a static archive,
# private to this tree. The clone headers must win over any system install:
# the camera lookAt fix lives in those headers.
#
COMPAGES_DIR := $(abspath $(P)/external/Compages)
COMPAGES_STATIC := $(COMPAGES_DIR)/build/libCompages.a
USER_CXXFLAGS += -isystem $(COMPAGES_DIR)/include
USER_CXXFLAGS += -isystem $(COMPAGES_DIR)/external/units/include
USER_CXXFLAGS += -isystem $(COMPAGES_DIR)/external/entt/src
USER_LDFLAGS += $(COMPAGES_STATIC)

pre-build:: $(COMPAGES_STATIC)

$(COMPAGES_STATIC):
	$(MAKE) -C $(COMPAGES_DIR) download-external-libs
	$(MAKE) -C $(COMPAGES_DIR) COMPILATION_MODE=release $(COMPAGES_STATIC)

###############################################################################
# rapidyaml, the YAML backend of BlackThorn: a static PIC archive, so it can be
# linked into librobotik-core.so without polluting the system. Built on demand
# by the Makefiles that link it (they depend on BLACKTHORN_STATIC_DEPS).
#
RYML_SRC := $(ROBOTIK_EXTERNAL)/rapidyaml
RYML_STATIC := $(RYML_SRC)/build/libryml.a

$(RYML_STATIC):
	@test -f $(RYML_SRC)/CMakeLists.txt || \
	    (echo "Missing $(RYML_SRC): run make download-external-libs" && false)
	@test -f $(RYML_SRC)/ext/c4core/CMakeLists.txt || \
	    (cd $(RYML_SRC) && git submodule update --init --recursive)
	cmake -S $(RYML_SRC) -B $(RYML_SRC)/build -DCMAKE_BUILD_TYPE=Release \
	    -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DRYML_BUILD_SHARED_LIBS=OFF \
	    -DRYML_BUILD_TESTS=OFF -DRYML_BUILD_BENCHMARKS=OFF -DRYML_BUILD_API=OFF
	cmake --build $(RYML_SRC)/build --target ryml -j$(shell nproc)

###############################################################################
# Kairos, the PDDL planner of the Planning module: a shared library built by
# its CMake. Only src/Robotik/Planning/Kairos includes its headers, but every
# program linking the core (static or shared) links it, found by its rpath.
#
KAIROS_SRC := $(ROBOTIK_EXTERNAL)/kairos
KAIROS_BUILD := $(KAIROS_SRC)/build
KAIROS_SHARED := $(KAIROS_BUILD)/src/libkairos.so
USER_LDFLAGS += -L$(KAIROS_BUILD)/src -Wl,-rpath,$(KAIROS_BUILD)/src -lkairos

$(KAIROS_SHARED):
	@test -f $(KAIROS_SRC)/CMakeLists.txt || \
	    (echo "Missing $(KAIROS_SRC): run make download-external-libs" && false)
	cmake -S $(KAIROS_SRC) -B $(KAIROS_BUILD) -DCMAKE_BUILD_TYPE=Release \
	    -DKAIROS_BUILD_TESTS=OFF -DKAIROS_BUILD_CLI=ON
	cmake --build $(KAIROS_BUILD) -j$(shell nproc)

FORGE_PREFIX := $(abspath $(P)/external/forge)
ifneq ($(wildcard $(FORGE_PREFIX)/include/pinocchio/parsers/urdf.hpp),)
USER_CXXFLAGS += -isystem $(FORGE_PREFIX)/include
USER_LDFLAGS += -L$(FORGE_PREFIX)/lib -Wl,-rpath,$(FORGE_PREFIX)/lib
USER_LDFLAGS += -lpinocchio_parsers -lpinocchio_default -lmujoco
endif
