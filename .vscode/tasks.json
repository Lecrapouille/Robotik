{
    // Tasks calling MyMakefile: 'make help' lists every goal. MyMakefile
    // already uses all the cores (JOBS=4 to keep some free).
    // Ctrl+Shift+B: build; Ctrl+Shift+P > "Run Test Task": the unit tests.
    // The scenarios are those staged by the build, in
    // build/linux-gcc-debug/lib/robotik/plugins/<Name>/scenarios.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
    },
    "tasks": [
        // --------------------------------------------------------------------
        // Build
        // --------------------------------------------------------------------
        {
            "label": "Build",
            "detail": "Core, simulator, headless, the plugins of PLUGINS, then compile_commands.json for IntelliSense",
            "type": "shell",
            "command": "make all compile-commands",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Build unit tests",
            "type": "shell",
            "command": "make Robotik-tests",
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Build one plugin",
            "detail": "Stages it in build/linux-gcc-debug/lib/robotik/plugins/<Name>",
            "type": "shell",
            "command": "make ${input:plugin}",
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Build with sanitizers",
            "detail": "AddressSanitizer and UndefinedBehaviorSanitizer, in build/linux-gcc-debug-address-undefined",
            "type": "shell",
            "command": "make all Robotik-tests SANITIZER=address,undefined",
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Build release",
            "type": "shell",
            "command": "make all COMPILATION_MODE=release",
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "make rebuild",
            "group": "build",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "compile_commands.json",
            "type": "shell",
            "command": "make compile-commands",
            "problemMatcher": []
        },

        // --------------------------------------------------------------------
        // Tests and checks
        // --------------------------------------------------------------------
        {
            "label": "Unit tests",
            "type": "shell",
            "command": "make check",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Unit tests: filter",
            "type": "shell",
            "command": "make run-Robotik-tests ARGS='--gtest_filter=${input:gtestFilter}'",
            "group": "test",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Check layers",
            "detail": "No include upwards, no truth call in the skills and the planner",
            "type": "shell",
            "command": "make check-layers",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Unit tests in valgrind",
            "type": "shell",
            "command": "make memcheck",
            "group": "test",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Coverage",
            "detail": "doc/code-coverage/index.html, shown in the editor by Coverage Gutters",
            "type": "shell",
            "command": "make coverage",
            "group": "test",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },

        // --------------------------------------------------------------------
        // Run
        // --------------------------------------------------------------------
        {
            "label": "Simulator",
            "type": "shell",
            "command": "make run-Robotik-Simulator",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Simulator: one scenario",
            "type": "shell",
            "command": "make run-Robotik-Simulator ARGS='${input:scenario}'",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Headless: one scenario",
            "detail": "Exit code 0 pass, 2 a run failed, 1 load error",
            "type": "shell",
            "command": "make run-Robotik-Headless ARGS='${input:scenario}'",
            "group": "test",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Headless: one scenario with its trace",
            "type": "shell",
            "command": "make run-Robotik-Headless ARGS='${input:scenario} --trace'",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },

        // --------------------------------------------------------------------
        // Code quality and documentation
        // --------------------------------------------------------------------
        {
            "label": "Format",
            "type": "shell",
            "command": "make format",
            "problemMatcher": []
        },
        {
            "label": "Check format",
            "type": "shell",
            "command": "make check-format",
            "problemMatcher": []
        },
        {
            "label": "clang-tidy",
            "type": "shell",
            "command": "make tidy",
            "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}"] }
        },
        {
            "label": "Doxygen",
            "type": "shell",
            "command": "make doc",
            "problemMatcher": []
        },

        // --------------------------------------------------------------------
        // Project
        // --------------------------------------------------------------------
        {
            "label": "Targets and flags",
            "type": "shell",
            "command": "make list-targets show-flags",
            "problemMatcher": []
        },
        {
            "label": "Install Pinocchio and MuJoCo",
            "detail": "From conda-forge in external/forge (make forge)",
            "type": "shell",
            "command": "make forge",
            "problemMatcher": []
        },
        {
            "label": "Update the third parties",
            "detail": "Moves them to the last commit of their VERSION, rewrites external/versions.lock",
            "type": "shell",
            "command": "make update-externals",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Clean everything",
            "detail": "veryclean: builds, third parties, documentation, reports",
            "type": "shell",
            "command": "make veryclean",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "plugin",
            "type": "pickString",
            "description": "Plugin to build (MicroDuck and HumanoidWalk fetch large models)",
            "default": "DualArm",
            "options": [
                "HelloWorld",
                "Painter",
                "PickAndPlace",
                "DualArm",
                "LineFollower",
                "FlyBrain",
                "HumanoidWalk",
                "MicroDuck"
            ]
        },
        {
            "id": "scenario",
            "type": "promptString",
            "description": "Scenario, experiment or workflow, from the root of the project",
            "default": "build/linux-gcc-debug/lib/robotik/plugins/DualArm/scenarios/factory_transfer.scenario.yaml"
        },
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "Google Test filter, such as 'Plugin*' or 'ConveyorBelt.*'",
            "default": "*"
        }
    ]
}
