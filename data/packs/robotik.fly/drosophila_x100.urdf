<?xml version="1.0"?>
<!-- Drosophila melanogaster (mouche du vinaigre) simplifiee, echelle x100 (metres, kg) : corps ~28 cm, ~1 kg (masse x1e6, a densite egale).
     Similitude dynamique a g constant : longueurs x100, masses x1e6, couples x1e8, vitesses articulaires /10
     (le temps du modele s'ecoule 10x plus lentement que celui de la vraie mouche : 200 Hz reel -> 20 Hz).
     Repere : x = avant, y = gauche, z = haut (REP-103). Racine = thorax, origine au centre du thorax.
     54 DDL : 6 pattes x 7 + 2 ailes x 3 + 2 halteres + cou 3 + abdomen 1.
     Nommage : pattes LF/LM/LH/RF/RM/RH (Left/Right, Front/Middle/Hind), proche de NeuroMechFly.
     Chaque patte : coxa_pitch, coxa_roll, coxa_yaw, femur_pitch, femur_roll, tibia_pitch, tarsus_pitch.
       Axes locaux au repere du segment (z = axe du segment) : pitch=y, roll=x, yaw=z.
     Symetrie : a signe de joint egal, gauche et droite font le MEME mouvement (miroir) -> un cerveau
       peut piloter les deux cotes avec les memes commandes.
     q = 0 : pose debout (voir bas des pattes : reperes *_tip). Les liens "_link" sont des reperes
       intermediaires de masse negligeable (URDF impose un lien entre deux joints). -->
<robot name="drosophila_x100">

  <link name="thorax">
    <visual>
      <geometry><cylinder length="0.12" radius="0.048"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.048"/></geometry>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.048"/></geometry>
      <origin xyz="-0.06 0 0" rpy="0 0 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.12" radius="0.048"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
    </collision>
    <inertial>
      <mass value="0.45"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00045"/>
    </inertial>
  </link>

  <link name="neck_yaw_link">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10"/>
    </inertial>
  </link>

  <link name="neck_pitch_link">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10"/>
    </inertial>
  </link>

  <joint name="neck_yaw" type="revolute">
    <parent link="thorax"/>
    <child link="neck_yaw_link"/>
    <origin xyz="0.07 0 0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10" lower="-0.8" upper="0.8"/>
    <dynamics damping="1" friction="0"/>
  </joint>

  <joint name="neck_pitch" type="revolute">
    <parent link="neck_yaw_link"/>
    <child link="neck_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="10" lower="-0.8" upper="0.8"/>
    <dynamics damping="1" friction="0"/>
  </joint>

  <link name="head">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <material name="head_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.028"/></geometry>
      <origin xyz="0.04 0.032 0.008" rpy="0 0 0"/>
      <material name="eye_red"><color rgba="0.70 0.10 0.10 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.028"/></geometry>
      <origin xyz="0.04 -0.032 0.008" rpy="0 0 0"/>
      <material name="eye_red"><color rgba="0.70 0.10 0.10 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.03" radius="0.008"/></geometry>
      <origin xyz="0.06 0 -0.035" rpy="0 0.9 0"/>
      <material name="proboscis"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.02" radius="0.006"/></geometry>
      <origin xyz="0.08 0.012 0.022" rpy="0 1.2 0"/>
      <material name="antenna"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.02" radius="0.006"/></geometry>
      <origin xyz="0.08 -0.012 0.022" rpy="0 1.2 0"/>
      <material name="antenna"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001215" ixy="0" ixz="0" iyy="0.0001215" iyz="0" izz="0.0001215"/>
    </inertial>
  </link>

  <joint name="neck_roll" type="revolute">
    <parent link="neck_pitch_link"/>
    <child link="head"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" velocity="10" lower="-0.8" upper="0.8"/>
    <dynamics damping="1" friction="0"/>
  </joint>

  <link name="eye_L">
    <!-- repere sensoriel, axe optique = +x -->
  </link>

  <joint name="head_to_eye_L" type="fixed">
    <parent link="head"/>
    <child link="eye_L"/>
    <origin xyz="0.04 0.055 0.008" rpy="0 0 1"/>
  </joint>

  <link name="eye_R">
    <!-- repere sensoriel, axe optique = +x -->
  </link>

  <joint name="head_to_eye_R" type="fixed">
    <parent link="head"/>
    <child link="eye_R"/>
    <origin xyz="0.04 -0.055 0.008" rpy="0 0 -1"/>
  </joint>

  <link name="abdomen">
    <visual>
      <geometry><cylinder length="0.13" radius="0.045"/></geometry>
      <origin xyz="-0.065 0 0" rpy="0 1.570796 0"/>
      <material name="abd_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <origin xyz="-0.13 0 0" rpy="0 0 0"/>
      <material name="abd_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.015" radius="0.0455"/></geometry>
      <origin xyz="-0.05 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.015" radius="0.0455"/></geometry>
      <origin xyz="-0.09 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.015" radius="0.0455"/></geometry>
      <origin xyz="-0.12 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.13" radius="0.045"/></geometry>
      <origin xyz="-0.065 0 0" rpy="0 1.570796 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="-0.065 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000574375" ixy="0" ixz="0" iyy="0.000574375" iyz="0" izz="0.00030375"/>
    </inertial>
  </link>

  <joint name="abdomen_pitch" type="revolute">
    <parent link="thorax"/>
    <child link="abdomen"/>
    <origin xyz="-0.06 0 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="5" lower="-0.6" upper="0.6"/>
    <dynamics damping="1" friction="0"/>
  </joint>

  <link name="wing_L_sweep_link">
