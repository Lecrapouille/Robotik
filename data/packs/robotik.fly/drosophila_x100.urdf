    <child link="LF_coxa_pitch_link"/>
    <origin xyz="0.055 0.03 -0.03" rpy="3.141593 -1.041326 1.212026"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="5" lower="-1" upper="1"/>
    <dynamics damping="1" friction="0"/>
  </joint>

  <joint name="LF_coxa_roll" type="revolute">
