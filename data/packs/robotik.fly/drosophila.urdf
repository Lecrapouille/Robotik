      <geometry><box size="0.0008 0.0025 2e-05"/></geometry>
      <origin xyz="-0.0001 0.00125 0" rpy="0 0 0"/>
      <material name="wing_clear"><color rgba="0.85 0.88 0.90 0.35"/></material>
