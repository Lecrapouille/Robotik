    <origin xyz="-0.0001 0.0004 0.0005" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1e-06" velocity="5000" lower="-1.2" upper="1.9"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <joint name="wing_L_deviation" type="revolute">
