    <child link="wing_R_dev_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="1e-06" velocity="5000" lower="-0.6" upper="0.6"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="wing_R">
