<?xml version="1.0"?>
<!-- Drosophila melanogaster (mouche du vinaigre) simplifiee, echelle REELLE (metres, kg) : corps ~2.8 mm, ~1 mg.
     Repere : x = avant, y = gauche, z = haut (REP-103). Racine = thorax, origine au centre du thorax.
     54 DDL : 6 pattes x 7 + 2 ailes x 3 + 2 halteres + cou 3 + abdomen 1.
     Nommage : pattes LF/LM/LH/RF/RM/RH (Left/Right, Front/Middle/Hind), proche de NeuroMechFly.
     Chaque patte : coxa_pitch, coxa_roll, coxa_yaw, femur_pitch, femur_roll, tibia_pitch, tarsus_pitch.
       Axes locaux au repere du segment (z = axe du segment) : pitch=y, roll=x, yaw=z.
     Symetrie : a signe de joint egal, gauche et droite font le MEME mouvement (miroir) -> un cerveau
       peut piloter les deux cotes avec les memes commandes.
     q = 0 : pose debout (voir bas des pattes : reperes *_tip). Les liens "_link" sont des reperes
       intermediaires de masse negligeable (URDF impose un lien entre deux joints). -->
<robot name="drosophila">

  <link name="thorax">
    <visual>
      <geometry><cylinder length="0.0012" radius="0.00048"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.00048"/></geometry>
      <origin xyz="0.0006 0 0" rpy="0 0 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.00048"/></geometry>
      <origin xyz="-0.0006 0 0" rpy="0 0 0"/>
      <material name="thorax_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.0012" radius="0.00048"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
    </collision>
    <inertial>
      <mass value="4.5e-07"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="4.5e-14" ixy="0" ixz="0" iyy="4.5e-14" iyz="0" izz="4.5e-14"/>
    </inertial>
  </link>

  <link name="neck_yaw_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
    </inertial>
  </link>

  <link name="neck_pitch_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
    </inertial>
  </link>

  <joint name="neck_yaw" type="revolute">
    <parent link="thorax"/>
    <child link="neck_yaw_link"/>
    <origin xyz="0.0007 0 0.00015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1e-06" velocity="100" lower="-0.8" upper="0.8"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <joint name="neck_pitch" type="revolute">
    <parent link="neck_yaw_link"/>
    <child link="neck_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1e-06" velocity="100" lower="-0.8" upper="0.8"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="head">
    <visual>
      <geometry><sphere radius="0.00045"/></geometry>
      <origin xyz="0.00035 0 0" rpy="0 0 0"/>
      <material name="head_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.00028"/></geometry>
      <origin xyz="0.0004 0.00032 8e-05" rpy="0 0 0"/>
      <material name="eye_red"><color rgba="0.70 0.10 0.10 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.00028"/></geometry>
      <origin xyz="0.0004 -0.00032 8e-05" rpy="0 0 0"/>
      <material name="eye_red"><color rgba="0.70 0.10 0.10 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.0003" radius="8e-05"/></geometry>
      <origin xyz="0.0006 0 -0.00035" rpy="0 0.9 0"/>
      <material name="proboscis"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.0002" radius="6e-05"/></geometry>
      <origin xyz="0.0008 0.00012 0.00022" rpy="0 1.2 0"/>
      <material name="antenna"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.0002" radius="6e-05"/></geometry>
      <origin xyz="0.0008 -0.00012 0.00022" rpy="0 1.2 0"/>
      <material name="antenna"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.00045"/></geometry>
      <origin xyz="0.00035 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.5e-07"/>
      <origin xyz="0.00035 0 0" rpy="0 0 0"/>
      <inertia ixx="1.215e-14" ixy="0" ixz="0" iyy="1.215e-14" iyz="0" izz="1.215e-14"/>
    </inertial>
  </link>

  <joint name="neck_roll" type="revolute">
    <parent link="neck_pitch_link"/>
    <child link="head"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1e-06" velocity="100" lower="-0.8" upper="0.8"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="eye_L">
    <!-- repere sensoriel, axe optique = +x -->
  </link>

  <joint name="head_to_eye_L" type="fixed">
    <parent link="head"/>
    <child link="eye_L"/>
    <origin xyz="0.0004 0.00055 8e-05" rpy="0 0 1"/>
  </joint>

  <link name="eye_R">
    <!-- repere sensoriel, axe optique = +x -->
  </link>

  <joint name="head_to_eye_R" type="fixed">
    <parent link="head"/>
    <child link="eye_R"/>
    <origin xyz="0.0004 -0.00055 8e-05" rpy="0 0 -1"/>
  </joint>

  <link name="abdomen">
    <visual>
      <geometry><cylinder length="0.0013" radius="0.00045"/></geometry>
      <origin xyz="-0.00065 0 0" rpy="0 1.570796 0"/>
      <material name="abd_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><sphere radius="0.00045"/></geometry>
      <origin xyz="-0.0013 0 0" rpy="0 0 0"/>
      <material name="abd_tan"><color rgba="0.72 0.52 0.25 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.00015" radius="0.000455"/></geometry>
      <origin xyz="-0.0005 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.00015" radius="0.000455"/></geometry>
      <origin xyz="-0.0009 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.00015" radius="0.000455"/></geometry>
      <origin xyz="-0.0012 0 0" rpy="0 1.570796 0"/>
      <material name="abd_band"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder length="0.0013" radius="0.00045"/></geometry>
      <origin xyz="-0.00065 0 0" rpy="0 1.570796 0"/>
    </collision>
    <inertial>
      <mass value="3e-07"/>
      <origin xyz="-0.00065 0 0" rpy="0 0 0"/>
      <inertia ixx="5.74375e-14" ixy="0" ixz="0" iyy="5.74375e-14" iyz="0" izz="3.0375e-14"/>
    </inertial>
  </link>

  <joint name="abdomen_pitch" type="revolute">
    <parent link="thorax"/>
    <child link="abdomen"/>
    <origin xyz="-0.0006 0 -0.0001" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1e-06" velocity="50" lower="-0.6" upper="0.6"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="wing_L_sweep_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
