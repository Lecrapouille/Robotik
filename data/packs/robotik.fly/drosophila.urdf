    <inertial>
      <mass value="3e-09"/>
      <origin xyz="0 0 0.0003945165" rpy="0 0 0"/>
      <inertia ixx="1.563183e-16" ixy="0" ixz="0" iyy="1.563183e-16" iyz="0" izz="1.35e-18"/>
    </inertial>
  </link>

  <joint name="LF_tarsus_pitch" type="revolute">
    <parent link="LF_tibia"/>
