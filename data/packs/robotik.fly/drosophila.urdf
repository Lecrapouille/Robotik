  </link>

  <link name="wing_L_dev_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
    </inertial>
  </link>

  <joint name="wing_L_sweep" type="revolute">
    <parent link="thorax"/>
