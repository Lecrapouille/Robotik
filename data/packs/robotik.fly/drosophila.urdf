    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="wing_R_sweep_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
    </inertial>
  </link>

  <link name="wing_R_dev_link">
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-20" ixy="0" ixz="0" iyy="1e-20" iyz="0" izz="1e-20"/>
    </inertial>
  </link>

  <joint name="wing_R_sweep" type="revolute">
    <parent link="thorax"/>
    <child link="wing_R_sweep_link"/>
    <origin xyz="-0.0001 -0.0004 0.0005" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1e-06" velocity="5000" lower="-1.2" upper="1.9"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <joint name="wing_R_deviation" type="revolute">
