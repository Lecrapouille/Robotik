    <child link="wing_R"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="1e-06" velocity="5000" lower="-1.6" upper="1.6"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <link name="haltere_L">
    <visual>
      <geometry><cylinder length="0.0005" radius="4e-05"/></geometry>
      <origin xyz="0 0.00025 0" rpy="1.570796 0 0"/>
