    </visual>
    <inertial>
      <mass value="1e-10"/>
      <origin xyz="0 0.0004 0" rpy="0 0 0"/>
      <inertia ixx="1e-17" ixy="0" ixz="0" iyy="1e-17" iyz="0" izz="1e-17"/>
    </inertial>
  </link>

  <joint name="haltere_L_flap" type="revolute">
    <parent link="thorax"/>
    <child link="haltere_L"/>
    <origin xyz="-0.00015 0.0004 0.0003" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1e-07" velocity="5000" lower="-1" upper="1"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

