      <geometry><box size="0.0008 0.0025 2e-05"/></geometry>
      <origin xyz="-0.0001 -0.00125 0" rpy="0 0 0"/>
      <material name="wing_clear"><color rgba="0.85 0.88 0.90 0.35"/></material>
    </visual>
    <visual>
      <geometry><cylinder length="0.0025" radius="4e-05"/></geometry>
      <origin xyz="0.0003 -0.00125 0" rpy="1.570796 0 0"/>
      <material name="wing_vein"><color rgba="0.08 0.07 0.06 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.0008 0.0025 2e-05"/></geometry>
