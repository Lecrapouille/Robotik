    <origin xyz="0.00055 0.0003 -0.0003" rpy="3.141593 -1.041326 1.212026"/>
    <axis xyz="0 1 0"/>
    <limit effort="1e-06" velocity="50" lower="-1" upper="1"/>
    <dynamics damping="1e-09" friction="0"/>
  </joint>

  <joint name="LF_coxa_roll" type="revolute">
