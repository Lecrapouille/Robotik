    <inertial>
      <mass value="2e-09"/>
      <origin xyz="-0.0001 0.00125 0" rpy="0 0 0"/>
      <inertia ixx="1.041667e-15" ixy="0" ixz="0" iyy="1.066667e-16" iyz="0" izz="1.148333e-15"/>
    </inertial>
  </link>

  <joint name="wing_L_pitch" type="revolute">
    <parent link="wing_L_dev_link"/>
    <child link="wing_L"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
