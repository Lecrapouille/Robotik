# Two arms sort four parts that a conveyor brings, with no behavior tree:
# the PDDL planner finds the steps from the goal, and the executor runs
# together the steps that do not depend on each other. The conveyor brings
# the next part while an arm carries the last one to its bin, and the arm
# comes back over its pick zone to wait for it.
scenario:
  id: conveyor
  description: Sort the red parts to the left bin, the blue ones to the right bin, both arms at once.
  world: worlds/conveyor_cell.world.yaml
  seed: 42

  controller:
    planner:
      domain: scenarios/conveyor.domain.pddl
      facts:
        - reaches(left, zone_left)
        - reaches(right, zone_right)
        - near(left, bin_left)
        - near(right, bin_right)
      goal:
        - at(p1, bin_left)
        - at(p2, bin_right)
        - at(p3, bin_left)
        - at(p4, bin_right)
      parallel: true

  # The parts are found by their true pose (no color detector in this
  # plugin); the wrist cameras still render in the simulator.
  perception: { fidelity: truth }   # the simulator gives the poses

  timeout: 120

  assertions:
    - controller.success
    - inside(p1, bin_left)
    - inside(p2, bin_right)
    - inside(p3, bin_left)
    - inside(p4, bin_right)
    - { condition: "collision_count(left) == 0", phase: always }
    - { condition: "collision_count(right) == 0", phase: always }
    - planner.replans == 0
    # Both arms moved at the same time for a while.
    - dual_arm.overlap > 2
    # The plan run step by step takes about 33 s (conveyor_sequential).
    - time < 20
# The workflow of the conveyor cell: the conveyor brings parts, the left arm
# sorts the parts of kind A, the right arm the parts of kind B. Two parts of
# each kind are in the cell at once. The arms work in parallel: the critical
# circuit says which one, or the conveyor, limits the throughput.
#   ./build/Robotik-Headless build/plugins/DualArm/scenarios/conveyor.workflow.yaml
# The bring operations name the Convey skill: after a run of conveyor or
# conveyor_grafcet, the Workflow panel can use their measured durations.
workflow:
  id: conveyor_line
  operators:
    - { id: conveyor, entity: conveyor }
    - { id: left, entity: left }
    - { id: right, entity: right }
  products:
    - id: part_a
      count: 2
      route:
        - { name: bring, on: conveyor, skill: "Convey(p1, feeder, zone_left)", duration: 1.5 }
        - { name: sort to bin_left, on: left, duration: 5.0 }
    - id: part_b
      count: 2
      route:
        - { name: bring, on: conveyor, skill: "Convey(p2, feeder, zone_right)", duration: 1.5 }
        - { name: sort to bin_right, on: right, duration: 6.0 }
# The conveyor of conveyor.scenario.yaml, driven by a GRAFCET instead of the
# PDDL planner (scenarios/conveyor.grafcet.json, drawn with
# TimedPetriNetEditor). One parallel branch per arm (AND divergence after
# Start); inside a branch, a second AND divergence lets the conveyor bring
# the next part while the arm carries the last one to its bin, and an AND
# convergence waits for both. The conveyor is a resource of the skills: when
# both branches ask for it, the skill scheduler makes one of them wait.
# conveyor.workflow.yaml gives the cycle time of this cell.
scenario:
  id: conveyor_grafcet
  description: Sort the parts with a GRAFCET of two parallel branches, one per arm.
  world: worlds/conveyor_cell.world.yaml
  seed: 42

  controller:
    grafcet:
      file: scenarios/conveyor.grafcet.json
      success: X35              # End: both branches are done

  perception: { fidelity: truth }   # the simulator gives the poses

  timeout: 120

  assertions:
    - controller.success
    - inside(p1, bin_left)
    - inside(p2, bin_right)
    - inside(p3, bin_left)
    - inside(p4, bin_right)
    - { condition: "collision_count(left) == 0", phase: always }
    - { condition: "collision_count(right) == 0", phase: always }
    # Both arms moved at the same time for a while.
    - dual_arm.overlap > 2
    - time < 20
# The same cell as conveyor.scenario.yaml, the plan run step by step: one
# arm or the conveyor moves at a time. Compare the end time of both runs.
scenario:
  id: conveyor_sequential
  description: Sort the red parts to the left bin, the blue ones to the right bin, one step at a time.
  world: worlds/conveyor_cell.world.yaml
  seed: 42

  controller:
    planner:
      domain: scenarios/conveyor.domain.pddl
      facts:
        - reaches(left, zone_left)
        - reaches(right, zone_right)
        - near(left, bin_left)
        - near(right, bin_right)
      goal:
        - at(p1, bin_left)
        - at(p2, bin_right)
        - at(p3, bin_left)
        - at(p4, bin_right)
      parallel: false

  # The parts are found by their true pose (no color detector in this
  # plugin); the wrist cameras still render in the simulator.
  perception: { fidelity: truth }   # the simulator gives the poses

  timeout: 120

  assertions:
    - controller.success
    - inside(p1, bin_left)
    - inside(p2, bin_right)
    - inside(p3, bin_left)
    - inside(p4, bin_right)
    - { condition: "collision_count(left) == 0", phase: always }
    - { condition: "collision_count(right) == 0", phase: always }
    - planner.replans == 0
    # Never two arms at once.
    - dual_arm.overlap == 0
