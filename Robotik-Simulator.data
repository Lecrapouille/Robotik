#pragma once

#include "Robotik/Common/Math.hpp"

#include <array>
#include <filesystem>
#include <memory>
#include <span>
#include <string>
#include <vector>

// ****************************************************************************
/// What the walking policy expects, read from walk.yaml (written by
/// prepare_assets.py). One entry per servo, in the order of the policy.
/// The mouth is not in this model: the training body has 14 servos.
// ****************************************************************************
struct DuckContract
{
    std::vector<std::string> joints;
    std::vector<double> kp;
    /// Derivative gain of the position actuator. Zero: viscosity is @ref
    /// damping.
    std::vector<double> kd;
    /// Viscous joint damping (N·m·s/rad), applied by MuJoCo, not by the PD law.
    std::vector<double> damping;
    std::vector<double> default_angle;
    std::vector<double> action_scale;
    std::vector<double> torque_limit;
    std::vector<double> armature;
    /// Physics steps per policy step.
    int decimation = 4;
    /// Physics step (s). The policy runs at 1 / (decimation * physics_step).
    double physics_step = 0.005;
    /// Largest |vx| (m/s), |vy| (m/s), |yaw rate| (rad/s).
    std::array<double, 3> max_command{ 0.4, 0.3, 1.0 };

    /// @throws std::runtime_error on a missing or inconsistent field.
    [[nodiscard]] static DuckContract load(std::filesystem::path const& p_path);
};

// ****************************************************************************
/// What the robot measures, as the policy wants it.
// ****************************************************************************
struct DuckInput
{
    /// IMU attitude in the world frame.
    robotik::Quaternion orientation;
    /// IMU angular velocity in the trunk frame (rad/s).
    robotik::Vector3 angular_velocity = robotik::Vector3::ZERO;
    /// Command: forward (m/s), lateral (m/s), yaw rate (rad/s).
    std::array<double, 3> command{};
    /// Joint positions and velocities, policy order.
    std::span<double const> positions;
    std::span<double const> velocities;
};

// ****************************************************************************
/// Microduck walking policy (ONNX, 14 servos): one observation in,
/// joint position offsets out. Plain C++ over ONNX Runtime; it knows nothing
/// of the simulation.
///
/// Observation (61), the order of duck-control obs.rs:
/// gyro (3), projected gravity (3), joint position minus home (14), joint
/// velocity (14), previous action (14), then the command block twist (3),
/// head (4, zeros) and body (6, zeros: x, y, z, roll, pitch, yaw).
/// Target of joint i: action_i * action_scale_i + default_angle_i.
// ****************************************************************************
class DuckPolicy
{
public:

    /// @throws std::runtime_error if the model or its contract cannot be read.
    DuckPolicy(std::filesystem::path const& p_model, DuckContract p_contract);
    ~DuckPolicy();

    [[nodiscard]] DuckContract const& contract() const
    {
        return m_contract;
    }

    /// Forgets the previous action (new episode).
    void reset();

    /// Runs the network once and returns one target per joint (rad).
    [[nodiscard]] std::span<double const> act(DuckInput const& p_input);

private:

    struct Onnx;
    std::unique_ptr<Onnx> m_onnx;
    DuckContract m_contract;
    std::vector<float> m_observation;
    std::vector<float> m_actions;
    std::vector<double> m_targets;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "DuckSkills.hpp"

#include "Robotik/Robot/Robot.hpp"
#include "Robotik/Task/RobotContext.hpp"
#include "Robotik/Robot/Sensors/Imu.hpp"

#include <algorithm>

/// Viscous brake after a lost IMU (JointGains::velocity_kp).
static void damp(robotik::JointSet& p_joints,
                 std::vector<robotik::JointId> const& p_ids)
{
    for (robotik::JointId const id : p_ids)
    {
        p_joints.spin(id, 0.0);
    }
}

// ****************************************************************************
StandSkill::StandSkill(DuckBody p_body,
                       std::vector<double> p_posture,
                       robotik::Seconds p_duration)
    : m_body(std::move(p_body)),
      m_posture(std::move(p_posture)),
      m_duration(p_duration)
{
}

void StandSkill::reset()
{
    m_elapsed = robotik::Seconds{};
}

robotik::Status StandSkill::tick(robotik::RobotContext& p_context, robotik::Seconds p_dt)
{
    robotik::JointSet& joints = p_context.robot.joints();
    for (std::size_t i = 0; i < m_body.joints.size(); ++i)
    {
        joints.moveTo(m_body.joints[i], m_posture[i]);
    }
    m_elapsed = m_elapsed + p_dt;
    return m_elapsed >= m_duration ? robotik::Status::SUCCESS
                                   : robotik::Status::RUNNING;
}

void StandSkill::cancel(robotik::RobotContext& p_context)
{
    p_context.robot.joints().hold();
}

// ****************************************************************************
WalkSkill::WalkSkill(DuckBody p_body,
                     DuckPolicy& p_policy,
                     std::array<double, 3> const& p_command,
                     robotik::Seconds p_duration,
                     robotik::Seconds p_period)
    : m_body(std::move(p_body)),
      m_policy(p_policy),
      m_command(p_command),
      m_duration(p_duration),
      m_period(p_period),
      m_positions(m_body.joints.size()),
      m_velocities(m_body.joints.size())
{
}

void WalkSkill::reset()
{
    // The policy keeps its last action from one walk to the next (Forward
    // then TurnLeft): the mission resets it with the episode.
    m_elapsed = robotik::Seconds{};
    m_wait = robotik::Seconds{};
}

robotik::Status WalkSkill::tick(robotik::RobotContext& p_context, robotik::Seconds p_dt)
{
    robotik::Robot& robot = p_context.robot;
    auto const* imu = robot.sensors().find<robotik::Imu>(m_body.imu);
    if (imu == nullptr || !imu->reading().valid)
    {
        damp(robot.joints(), m_body.joints);
        return robotik::Status::FAILURE;
    }

    m_wait = m_wait - p_dt;
    if (m_wait.value() <= 1e-9)
    {
        m_wait = m_wait + m_period;
        robotik::JointSet& joints = robot.joints();
        for (std::size_t i = 0; i < m_body.joints.size(); ++i)
        {
            m_positions[i] = joints.position(m_body.joints[i]);
            m_velocities[i] = joints.velocity(m_body.joints[i]);
        }
        std::array<double, 3> command{};
        std::array<double, 3> const& limit = m_policy.contract().max_command;
        for (std::size_t i = 0; i < command.size(); ++i)
        {
            command[i] = std::clamp(m_command[i], -limit[i], limit[i]);
        }
        DuckInput const input{ imu->reading().orientation,
                               imu->reading().angular_velocity,
                               command,
                               m_positions,
                               m_velocities };
        std::span<double const> const targets = m_policy.act(input);
        for (std::size_t i = 0; i < m_body.joints.size(); ++i)
        {
            joints.moveTo(m_body.joints[i], targets[i]);
        }
    }

    m_elapsed = m_elapsed + p_dt;
    bool const done = m_duration.value() > 0.0 && m_elapsed >= m_duration;
    return done ? robotik::Status::SUCCESS : robotik::Status::RUNNING;
}

void WalkSkill::cancel(robotik::RobotContext& p_context)
{
    p_context.robot.joints().hold();
}
