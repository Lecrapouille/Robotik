            { "id": 12, "caption": "Grasp p3", "tokens": 0, "x": 150, "y": 1120 },
            { "id": 13, "caption": "Lift p3", "tokens": 0, "x": 150, "y": 1210 },
            { "id": 14, "caption": "Over bin_left", "tokens": 0, "x": 150, "y": 1300 },
