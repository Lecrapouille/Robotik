#pragma once

#include "DuckPolicy.hpp"

#include "Robotik/Robot/Joints.hpp"
#include "Robotik/Task/Skills/Skill.hpp"

#include <array>
#include <string>
#include <vector>

// ****************************************************************************
/// Joints of the policy, in its order, and the IMU that feeds it.
// ****************************************************************************
struct DuckBody
{
    std::vector<robotik::JointId> joints;
    std::string imu;
};

// ****************************************************************************
/// Holds the home posture of the policy for a while: the duck settles
/// on its feet before walking.
// ****************************************************************************
class StandSkill final: public robotik::Skill
{
public:

    StandSkill(DuckBody p_body,
               std::vector<double> p_posture,
               robotik::Seconds p_duration);

    void reset() override;
    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

private:

    DuckBody m_body;
    std::vector<double> m_posture;
    robotik::Seconds m_duration;
    robotik::Seconds m_elapsed{};
};

// ****************************************************************************
/// Walks with a velocity command for a while (forever when the
/// duration is not positive). The command is read at each policy run: a panel
/// may change it while the duck walks.
///
/// The policy runs every decimation physics steps on the IMU and the joint
/// encoders; between two runs the joint PD loops hold its targets. A tilt
/// does not fail the skill: this policy was trained to stand back up. The
/// skill fails only when the IMU is lost, and then leaves the joints in
/// damping mode.
// ****************************************************************************
class WalkSkill final: public robotik::Skill
{
public:

    WalkSkill(DuckBody p_body,
              DuckPolicy& p_policy,
              std::array<double, 3> const& p_command,
              robotik::Seconds p_duration,
              robotik::Seconds p_period);

    void reset() override;
    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

private:

    DuckBody m_body;
    DuckPolicy& m_policy;
    /// Forward (m/s), lateral (m/s), yaw rate (rad/s), owned by the mission.
    std::array<double, 3> const& m_command;
    robotik::Seconds m_duration;
    /// Time between two policy runs.
    robotik::Seconds m_period;
    robotik::Seconds m_elapsed{};
    robotik::Seconds m_wait{};
    std::vector<double> m_positions;
    std::vector<double> m_velocities;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "DuckMission.hpp"

#include "Robotik/Package/Plugin/PluginAPI.hpp"
#include "Robotik/Package/Simulation.hpp"

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <memory>
#include <numbers>
#include <string>
#include <string_view>

/// Largest host time simulated in one update (s): a slow frame does not pile
/// up a lag the simulation never catches up.
#define MAX_LAG_S 0.05
/// Trunk below this stands for a duck that is down (home is about 0.12 m).
#define FALLEN_HEIGHT_M 0.07

/// Prints one number with a printf format.
static std::string format(char const* p_format, double p_value)
{
    char line[96];
    std::snprintf(line, sizeof(line), p_format, p_value);
    return line;
}

// ****************************************************************************
/// Microduck walking by a learned policy. The plugin owns the clock
/// (host.clock: plugin): it steps the simulation at the physics rate of the
/// training, whatever the host rate, so the policy runs at 50 Hz.
/// Its panel changes the walk command while the duck walks.
// ****************************************************************************
class MicroDuckPlugin final: public robotik::Plugin
{
public:

    static robotik::PluginInfo describe()
    {
        return { .id = "robotik.microduck" };
    }

    RobotikPluginStatus setup(robotik::Host& p_host,
                              std::string_view p_scenario) override
    {
        m_mission.reset();
        if (p_scenario != "drive" && p_scenario != "tour" &&
            p_scenario != "walk_forward")
        {
            p_host.error("unknown microduck scenario");
            return ROBOTIK_PLUGIN_ERR_SETUP;
        }
        m_mission = std::make_unique<DuckMission>();
        p_host.bindMission(*m_mission);
        p_host.addPanel("microduck", "Micro Duck", &onDraw, this);
        return ROBOTIK_PLUGIN_OK;
    }

    RobotikPluginStatus update(robotik::Host& p_host, double p_dt) override
    {
        robotik::Simulation* simulation = p_host.simulation();
        if (m_mission == nullptr || simulation == nullptr)
        {
            return ROBOTIK_PLUGIN_OK;
        }
        robotik::Seconds const step = m_mission->physicsStep();
        m_lag = std::min(m_lag + p_dt, MAX_LAG_S);
        // The physics goes on after the end of the run, so the simulator
        // shows a fall. The verdict is already frozen; the headless host
        // stops at the end.
        while (m_lag + 1e-9 >= step.value())
        {
            simulation->step(step);
            m_lag -= step.value();
        }
        return ROBOTIK_PLUGIN_OK;
    }

    RobotikPluginStatus shutdown(robotik::Host& /*p_host*/) override
    {
        m_mission.reset();
        return ROBOTIK_PLUGIN_OK;
    }

private:

    static void onDraw(void* p_user, RobotikCanvas const* p_canvas)
    {
        static_cast<MicroDuckPlugin*>(p_user)->draw(robotik::Canvas(p_canvas));
    }

    void draw(robotik::Canvas const& p_canvas)
    {
        if (m_mission == nullptr)
        {
            return;
        }
        // Sliders speak cm/s and deg/s; the command is SI.
        std::array<double, 3>& command = m_mission->command();
        constexpr double DEG = 180.0 / std::numbers::pi;
        int vx = static_cast<int>(std::lround(command[0] * 100.0));
        int vy = static_cast<int>(std::lround(command[1] * 100.0));
        int yaw = static_cast<int>(std::lround(command[2] * DEG));
        p_canvas.text("Walk command (applied at once)");
        if (p_canvas.sliderInt("forward cm/s", vx, -40, 40))
        {
            command[0] = vx / 100.0;
        }
        if (p_canvas.sliderInt("left cm/s", vy, -30, 30))
        {
            command[1] = vy / 100.0;
        }
        if (p_canvas.sliderInt("turn deg/s", yaw, -57, 57))
        {
            command[2] = yaw / DEG;
        }
        if (p_canvas.button("Stop"))
        {
            command = {};
        }
        p_canvas.separator();
        p_canvas.text(format("Distance %.2f m", m_mission->distance()));
        if (m_mission->height() < FALLEN_HEIGHT_M)
        {
            p_canvas.textColored(0.90F, 0.25F, 0.25F, "The duck fell: Replay");
        }
        else
        {
            p_canvas.text(format("Trunk height %.3f m", m_mission->height()));
        }
    }

    std::unique_ptr<DuckMission> m_mission;
    /// Host time not yet simulated (s).
    double m_lag = 0.0;
};

ROBOTIK_EXPORT_PLUGIN(MicroDuckPlugin)
# The Microduck (Pollen Robotics, about 25 cm, 14 servos) stands on an
# empty floor. Its home posture is the standing pose the walking policy was
# trained from. Z-up, metres, radians.
world:
  id: flat
  floor: { friction: 1.0 }

  entities:
    - id: duck
      type: robot
      model: robotik.pollen.microduck
      pose: { position: [0.0, 0.0, 0.12] }
      home:
        left_hip_yaw: 0.0
        left_hip_roll: -0.087266463
        left_hip_pitch: -0.457924
        left_knee: -0.00494
        left_ankle: 0.452984
        neck_pitch: 0.34906585
        head_pitch: 0.34906585
        head_yaw: 0.0
        head_roll: 0.0
        right_hip_yaw: 0.0
        right_hip_roll: 0.087266463
        right_hip_pitch: 0.457924
        right_knee: 0.00494
        right_ankle: -0.452984
      sensors:
        imu: { type: imu, parent: trunk_base, frequency: 200 }
      actuators:
        body: { type: joint_group }
# The Microduck in its playground: a room of 2.4 m by 2.4 m with low walls,
# a sofa, a pouf and a shelf (one fixed body: the duck bumps into them for
# real), and a light toy box it can push. Z-up, metres, radians. Seen from
# above:
#
#                              sofa (0, 0.95)
#
#                     duck (-0.4, -0.4) -->  toy (0.0, -0.4)    shelf (1.04, -0.55)
#        pouf (-0.8, -0.75)
world:
  id: playground
  floor: { friction: 1.0 }

  entities:
    - id: duck
      type: robot
      model: robotik.pollen.microduck
      # Facing +x, at a corner of the free middle of the room.
      pose: { position: [-0.4, -0.4, 0.12] }
      home:
        left_hip_yaw: 0.0
        left_hip_roll: -0.087266463
        left_hip_pitch: -0.457924
        left_knee: -0.00494
        left_ankle: 0.452984
        neck_pitch: 0.34906585
        head_pitch: 0.34906585
        head_yaw: 0.0
        head_roll: 0.0
        right_hip_yaw: 0.0
        right_hip_roll: 0.087266463
        right_hip_pitch: 0.457924
        right_knee: 0.00494
        right_ankle: -0.452984
      sensors:
        imu: { type: imu, parent: trunk_base, frequency: 200 }
      actuators:
        body: { type: joint_group }

    - id: room
      type: body
      model: robotik.microduck.playground
      physics: fixed

    # A light cardboard box, 12 cm: a free body when the scenario makes it
    # rigid (physics.overrides), else drawn only.
    - id: toy
      type: prop
      shape: { type: box, size: [0.12, 0.12, 0.12] }
      color: [0.85, 0.35, 0.30]
      mass: 0.08
      friction: 0.6
      pose: { position: [0.0, -0.4, 0.06] }
