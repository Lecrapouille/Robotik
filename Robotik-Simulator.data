#pragma once

#include "PickPlaceControl.hpp"

#include "Robotik/Common/Random.hpp"
#include "Robotik/Task/Mission.hpp"

#include <array>
#include <cstdint>

inline constexpr std::size_t RL_OBSERVATIONS = PICK_PLACE_OBSERVATIONS;
inline constexpr std::size_t RL_ACTIONS = PICK_PLACE_ACTIONS;

// ****************************************************************************
/// One rendered pick-and-place episode driven by the scripted policy.
///
/// Same observation, action and reward as Robotik-PickAndPlaceRL (see
/// PickPlaceControl.hpp). @c step stays empty: @ref act holds the action for
/// the control period itself, and a policy step from inside a simulation
/// step would recurse.
// ****************************************************************************
class RlMission final: public robotik::Mission
{
public:

    void reset(robotik::Cell& p_cell,
               robotik::Seed p_seed) override;
    void step(robotik::Cell& /*p_cell*/, robotik::Seconds /*p_dt*/) override
    {
        // Empty on purpose: act() steps the cell itself (see the class).
    }
    robotik::Status
    status(robotik::Cell const& /*p_cell*/) const override;

    /// One policy action, or the pause before the next episode.
    void act(robotik::Cell& p_cell, double p_dt);

    bool converged = true;
    float mix = 1.0F;
    bool repeat = true;
    int max_steps = 120;
    std::array<float, RL_OBSERVATIONS> observation{};
    std::array<float, RL_ACTIONS> action{};
    std::uint32_t steps = 0;
    float episode_return = 0.0F;
    std::uint32_t delivered = 0;
    std::uint32_t failed = 0;
    bool done = false;
    bool success = false;
    bool ready = false;

private:

    robotik::Random m_noise{ robotik::Seed{ 1 } };
    PickPlaceObservation m_observation;
    PickPlaceAction m_action;
    PickPlaceReward m_reward;
    double m_pause = 0.0;
};
# A 6-axis arm, a wrist camera and a vacuum cup, a cube to move and an open
# box. Each sensor and actuator is a resource of the same name, reserved by
# the skills and disabled by faults. Z-up, metres, radians.
world:
  id: pick_place_cell

  entities:
    - id: robot
      type: robot
      model: robotik.robots.robot_6axis
      # The tool points down.
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      sensors:
        wrist_camera:
          type: camera            # camera | rgbd
          parent: link6
          # Optical frame (z forward, x right, y down) in the parent link frame.
          position: [0.05, 0.0, 0.0]
          rpy: [0.0, 0.0, 0.0]
          fov: 70                 # vertical, degrees
          resolution: [320, 240]
          frequency: 15           # Hz
          noise: 0.01             # gaussian, fraction of the color range
      actuators:
        arm: { type: joint_group }   # no joints listed: every joint

    # The mounted tool brings its actuator. The others wait in storage; the
    # simulator can swap them.
    - id: vacuum
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: robot.flange, frame: tool_mount }
      actuators:
        gripper: { type: vacuum }
    - { id: plain, type: tool, model: robotik.tools.default }
    - { id: drill, type: tool, model: robotik.tools.drill }
    - { id: fingers, type: tool, model: robotik.tools.gripper }
    - { id: welder, type: tool, model: robotik.tools.welding }

    # Props: the robot only knows the nominal positions; randomize shifts the
    # real ones at each reset (uniform offsets drawn from the seed).
    - id: red_cube
      type: prop
      kind: cube                # type of the PDDL planner (scenarios/*.domain.pddl)
      shape: { type: box, size: [0.04, 0.04, 0.04] }
      color: [0.9, 0.1, 0.1]
      mass: 0.05                # kg, wood; used at the rigid physics level
      pose: { position: [0.40, 0.20, 0.02] }
      randomize: { x: [-0.02, 0.02], y: [-0.02, 0.02] }
    - id: box
      type: prop
      kind: bin
      shape: { type: container, size: [0.16, 0.16, 0.08] }
      color: [0.2, 0.4, 0.9]
      pose: { position: [0.40, -0.20, 0.04] }
