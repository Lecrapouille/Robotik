P := ../..
M := $(P)/.makefile

include $(P)/Makefile.common
TARGET_NAME := robotik_humanoid_walk
TARGET_DESCRIPTION := Humanoid walking by a learned policy
PLUGIN_NAME := HumanoidWalk
PLUGIN_DIR := $(P)/plugins/HumanoidWalk
PLUGIN_SRC := $(PLUGIN_DIR)/src
include $(M)/project/Makefile

LIB_FILES := $(wildcard $(PLUGIN_SRC)/*.cpp)

# The LimX repositories (dependencies of plugin.yaml) and the ONNX
# Runtime release (downloaded below) are private to this plugin. Without them
# the plugin is skipped. The asset pack data/hu_d04 is made from the clones.
ORT_VERSION := 1.20.1
ONNXRUNTIME_DIR := $(THIRD_PARTIES_DIR)/onnxruntime
LIMX_DESCRIPTION := $(THIRD_PARTIES_DIR)/humanoid-description
LIMX_CONTROLLERS := $(THIRD_PARTIES_DIR)/humanoid-rl-deploy-cpp
HU_D04 := $(abspath $(PLUGIN_DIR)/data/hu_d04)
PLUGIN_REQUIRES := $(ONNXRUNTIME_DIR)/include/onnxruntime_cxx_api.h
PLUGIN_REQUIRES += $(LIMX_DESCRIPTION) $(LIMX_CONTROLLERS)
PLUGIN_DEPENDS := $(HU_D04)/walk.onnx

USER_CXXFLAGS += -isystem $(ONNXRUNTIME_DIR)/include
USER_LDFLAGS += -L$(ONNXRUNTIME_DIR)/lib -Wl,-rpath,$(ONNXRUNTIME_DIR)/lib -lonnxruntime

include $(P)/plugins/plugin.mk

$(HU_D04)/walk.onnx:
	python3 -I $(PLUGIN_DIR)/prepare_assets.py $(LIMX_DESCRIPTION) $(LIMX_CONTROLLERS) $(PLUGIN_DIR)/data

# Prebuilt release of Microsoft: nothing to compile.
download-external-libs::
	@if [ ! -f $(ONNXRUNTIME_DIR)/include/onnxruntime_cxx_api.h ]; then \
	    case "$$(uname -m)" in \
	        x86_64) arch=x64 ;; aarch64) arch=aarch64 ;; \
	        *) echo "No ONNX Runtime release for $$(uname -m)"; exit 1 ;; \
	    esac; \
	    name=onnxruntime-linux-$$arch-$(ORT_VERSION); \
	    cd $(THIRD_PARTIES_DIR) && \
	    curl -Ls https://github.com/microsoft/onnxruntime/releases/download/v$(ORT_VERSION)/$$name.tgz | tar -xz && \
	    rm -rf onnxruntime && mv $$name onnxruntime; \
	fi
# HumanoidWalk

A LimX HU_D04_01 humanoid (31 joints) walks in a circle with the walking
policy trained by LimX. No training is needed: the policy (`policy.onnx`)
comes with [humanoid-rl-deploy-cpp](https://github.com/limxdynamics/humanoid-rl-deploy-cpp),
the robot with [humanoid-description](https://github.com/limxdynamics/humanoid-description)
(both Apache-2.0).

## Build

```bash
make -C plugins/HumanoidWalk download-external-libs   # LimX repositories (dependencies of plugin.yaml) + ONNX Runtime release
make -C plugins/HumanoidWalk -j"$(nproc)"             # runs prepare_assets.py once, then builds
./build/Robotik-Simulator build/plugins/HumanoidWalk/scenarios/walk.scenario.yaml   # Space: play
./build/Robotik-Headless build/plugins/HumanoidWalk/scenarios/walk_circle.scenario.yaml --trace
```

Two scenarios:

- `walk` (simulator): the robot walks until you stop the run. The panel
  **Humanoid** changes the command while it walks (forward, left, turn,
  Stop) and shows the path radius, the turns and the pelvis height.
- `walk_circle` (test): 25 s on a circle of 1 m, judged by assertions.

`prepare_assets.py` writes `data/hu_d04/` (gitignored): the serial URDF
without its floating joint, the meshes, `walk.onnx` and its contract
`walk.yaml` (joint order, PD gains, default posture, scales, armature).
Without ONNX Runtime or this folder, `make` skips the plugin.

## How it works

- The robot uses the **serial** URDF: the ankles and the waist are plain
  joints, as in the training. The MuJoCo file of LimX has the real closed
  linkages and needs their closed-source projection tool.
- `WalkMission` plugs a floating-base MuJoCo backend **without gravity
  compensation**, with the rotor armature, and gives each joint the PD gains
  of the policy with no slew (`JointGains::speed_ratio` = infinity).
- The plugin owns the clock: it steps the simulation every 1 ms, and the
  `Walk` skill runs the policy every 10 steps (100 Hz) on the IMU and the
  joint encoders only. Ground truth only feeds the metrics.
- The physics is MuJoCo: masses and inertias of the URDF, torque limits,
  contacts. The URDF of LimX only collides by the feet; `prepare_assets.py`
  adds the collision primitives of their MuJoCo file, so a falling robot
  lands on its body.
- When the IMU is lost (fault) or the robot lies down, `Walk` fails and
  leaves the joints in damping mode, as the LimX robot does: the robot
  falls. The run ends there, but in the simulator the physics goes on, so
  you see the fall.
- The command (`vx`, `vy`, `yaw_rate`) is in the scenario parameters. The
  circle radius is `vx / yaw_rate`.

Metrics: `humanoid.height_min`, `humanoid.distance`, `humanoid.turns`,
`humanoid.radius`, `humanoid.commanded_radius`.
# Generated by the plugin Makefile (prepare_assets.py) from the LimX
# repositories: URDF, meshes, walk.onnx, walk.yaml. Only pack.yaml is kept.
hu_d04/
id: robotik.limx
version: 1.0.0
license: Apache-2.0
source: https://github.com/limxdynamics/humanoid-description
description: >
  LimX HU_D04_01 humanoid (serial URDF, STL meshes) and its walking policy
  from humanoid-rl-deploy-cpp. Generated by prepare_assets.py.
models:
  hu_d04_01: hu_d04/HU_D04_01.urdf
# A humanoid (LimX HU_D04_01) walks by a learned policy. The pack data/ is
# made by the Makefile of the plugin from the LimX repositories.
plugin:
  id: robotik.humanoid_walk
  name: Humanoid walk
  version: 1.0.0
  api_version: 1
  category: Learning
  description: A LimX humanoid walks in a circle with a trained walking policy (ONNX).

library:
  entrypoint: librobotik_humanoid_walk.so

resources:
  directory: data

# Libraries the plugin is built with, and their license. thirdparties with a
# repo are cloned into external/ by make download-external-libs and built by
# the Makefile; system ones come from the system (pkg-config name).
# ONNX Runtime is a prebuilt release (no repo): the Makefile downloads it.
dependencies:
  thirdparties:
    - { repo: limxdynamics/humanoid-description, license: Apache-2.0, description: "LimX HU_D04 humanoid: URDF and meshes" }
    - { repo: limxdynamics/humanoid-rl-deploy-cpp, license: Apache-2.0, description: "LimX controllers: the trained walking policy" }
    - { name: onnxruntime, url: "https://github.com/microsoft/onnxruntime", license: MIT, description: Inference of the walking policy }

# The plugin steps the simulation at the physics rate of the policy. The
# view (Y-up) looks at the circle walked around the origin.
host:
  clock: plugin
  view:
    eye: [0.0, 2.2, 3.4]
    target: [0.0, 0.5, 0.0]

scenarios:
  directory: scenarios
  entries:
    - { id: walk, name: Walk (panel), file: walk.scenario.yaml }
    - { id: walk_circle, name: Walk in a circle, file: walk_circle.scenario.yaml }
#!/usr/bin/env python3
"""Build the asset pack of the HumanoidWalk plugin from the LimX repositories.

Called by the Makefile of the plugin once its external/ clones are there. Only the
files needed for walking are copied (the clones also hold USD files):

  - the serial URDF of HU_D04_01 (the ankles and the waist are plain joints,
    as in the training; the MuJoCo file of LimX has the closed linkages),
    without its floating joint: RobotIK adds the free joint itself;
  - the STL meshes the URDF uses, and the collision primitives of the LimX
    MuJoCo file (the URDF only collides by the feet);
  - the walking policy (policy.onnx) and its contract (walk.yaml): joint
    order, PD gains, default posture, scales, torque limits, rotor armature.

    python3 prepare_assets.py <humanoid-description> <humanoid-rl-deploy-cpp> <data dir>

Only the Python standard library is used.
"""

import re
import shutil
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

ROBOT = "HU_D04_01"
DESCRIPTION = "HU_D04_description"
# Links without mass (frames) get this tiny body, so MuJoCo does not give
# them its default of 1 kg.
FRAME_MASS = "0.001"
FRAME_INERTIA = "1e-07"


def numbers(text: str, key: str) -> list[float]:
    """Values of the list named key in a LimX param.yaml (flow or block
    style, with comments)."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        match = re.match(r"^(\s*)" + re.escape(key) + r":(.*)$", line)
        if match is None:
            continue
        indent = len(match.group(1))
        body = [match.group(2)]
        for next_line in lines[i + 1:]:
            stripped = next_line.split("#")[0]
            if stripped.strip() == "":
                continue
            if len(stripped) - len(stripped.lstrip()) <= indent and \
               not stripped.lstrip().startswith(("-", "]")):
                break
            body.append(stripped)
        joined = " ".join(part.split("#")[0] for part in body)
        return [float(x) for x in re.findall(r"-?\d+\.?\d*(?:[eE]-?\d+)?", joined)]
    raise KeyError(key)


def number(text: str, key: str) -> float:
    match = re.search(r"^\s*" + re.escape(key) + r":\s*([-0-9.eE]+)", text, re.M)
    if match is None:
        raise KeyError(key)
    return float(match.group(1))


def strip_floating_base(robot: ET.Element) -> None:
    """Remove root_link and floating_base_joint: base_link becomes the root."""
    for joint in robot.findall("joint"):
        if joint.get("type") == "floating":
            robot.remove(joint)
            parent = joint.find("parent").get("link")
            for link in robot.findall("link"):
                if link.get("name") == parent:
                    robot.remove(link)


def relocate_meshes(robot: ET.Element, source: Path, meshes: Path) -> None:
    """package:// paths become meshes/<name>.stl, next to the URDF."""
    meshes.mkdir(parents=True, exist_ok=True)
    for mesh in robot.iter("mesh"):
        name = Path(mesh.get("filename")).name
        target = Path(name).stem + ".stl"
        shutil.copyfile(source / name, meshes / target)
        mesh.set("filename", "meshes/" + target)


def give_frames_mass(robot: ET.Element) -> None:
    for link in robot.findall("link"):
        inertial = link.find("inertial")
        mass = inertial.find("mass") if inertial is not None else None
        if mass is not None and float(mass.get("value")) > 1e-8:
            continue
        if inertial is not None:
            link.remove(inertial)
        inertial = ET.SubElement(link, "inertial")
        ET.SubElement(inertial, "origin", xyz="0 0 0", rpy="0 0 0")
        ET.SubElement(inertial, "mass", value=FRAME_MASS)
        ET.SubElement(inertial, "inertia", ixx=FRAME_INERTIA, ixy="0", ixz="0",
                      iyy=FRAME_INERTIA, iyz="0", izz=FRAME_INERTIA)


def add_collisions(robot: ET.Element, mjcf: Path) -> None:
    """Copy the collision primitives of the LimX MuJoCo file onto the URDF
    links that have none (the URDF only keeps the feet): a robot that falls
    must land on its body, not sink into the floor. URDF has no capsule: a
    capsule becomes the cylinder that holds it."""
    links = {link.get("name"): link for link in robot.findall("link")}
    for body in ET.parse(mjcf).getroot().iter("body"):
        link = links.get(body.get("name"))
        if link is None or link.find("collision") is not None:
            continue
        for geom in body.findall("geom"):
            kind = geom.get("type", "sphere")
            if geom.get("class") == "visual" or kind == "mesh":
                continue
            euler = [float(x) for x in geom.get("euler", "0 0 0").split()]
            if sum(1 for angle in euler if angle != 0.0) > 1:
                sys.exit(f"{body.get('name')}: euler on two axes is not converted")
            size = [float(x) for x in geom.get("size").split()]
            collision = ET.SubElement(link, "collision")
            # One rotation axis: MuJoCo euler and URDF rpy agree.
            ET.SubElement(collision, "origin", xyz=geom.get("pos", "0 0 0"),
                          rpy=" ".join(f"{angle:g}" for angle in euler))
            geometry = ET.SubElement(collision, "geometry")
            if kind == "box":
                ET.SubElement(geometry, "box", size=" ".join(f"{2 * s:g}" for s in size))
            elif kind == "sphere":
                ET.SubElement(geometry, "sphere", radius=f"{size[0]:g}")
            elif kind in ("cylinder", "capsule"):
                length = 2 * size[1] + (2 * size[0] if kind == "capsule" else 0.0)
                ET.SubElement(geometry, "cylinder", radius=f"{size[0]:g}", length=f"{length:g}")
            else:
                sys.exit(f"{body.get('name')}: geom type {kind} is not converted")


def set_efforts(robot: ET.Element, efforts: dict[str, float]) -> None:
    """The deployment torque limits: a serial ankle sums its two motors."""
    for joint in robot.findall("joint"):
        limit = joint.find("limit")
        if limit is not None and joint.get("name") in efforts:
            limit.set("effort", f"{efforts[joint.get('name')]:g}")


def flow(values: list) -> str:
    return "[" + ", ".join(f"{v:g}" if isinstance(v, float) else str(v) for v in values) + "]"


def main() -> None:
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    description = Path(sys.argv[1]) / DESCRIPTION
    controller = (Path(sys.argv[2]) / "src/humanoid-rl-deploy-cpp/robot_controllers"
                  / "walking_controller/config" / ROBOT)
    output = Path(sys.argv[3]) / "hu_d04"
    output.mkdir(parents=True, exist_ok=True)

    # Joint order of the policy: the SRDF order (same as the robot SDK).
    srdf = ET.parse(description / "urdf" / f"{ROBOT}.srdf").getroot()
    motors = [j for j in srdf.iter("joint") if j.get("gear_ratio") is not None]
    names = [j.get("name") for j in motors]
    # Reflected rotor inertia: rotor inertia times the gear ratio squared.
    armature = [float(j.get("mass")) * float(j.get("gear_ratio")) ** 2 for j in motors]

    param = (controller / "param.yaml").read_text()
    size = int(number(param, "actions_size"))
    if size != len(names):
        sys.exit(f"policy has {size} actions, the SRDF {len(names)} joints")
    efforts = numbers(param, "user_torque_limit")

    tree = ET.parse(description / "urdf" / f"{ROBOT}.urdf")
    robot = tree.getroot()
    strip_floating_base(robot)
    relocate_meshes(robot, description / "meshes" / ROBOT, output / "meshes")
    give_frames_mass(robot)
    add_collisions(robot, description / "xml" / f"{ROBOT}.xml")
    set_efforts(robot, dict(zip(names, efforts)))
    ET.indent(tree)
    tree.write(output / f"{ROBOT}.urdf", encoding="utf-8", xml_declaration=True)

    shutil.copyfile(controller / "policy" / "policy.onnx", output / "walk.onnx")
    contract = [
        f"# Contract of walk.onnx, generated by prepare_assets.py from",
        f"# humanoid-rl-deploy-cpp walking_controller/config/{ROBOT}/param.yaml.",
        "walk:",
        f"  joints: {flow(names)}",
        f"  kp: {flow(numbers(param, 'kp'))}",
        f"  kd: {flow(numbers(param, 'kd'))}",
        f"  default_angle: {flow(numbers(param, 'default_angle'))}",
        f"  action_scale: {flow(numbers(param, 'action_scale'))}",
        f"  torque_limit: {flow(efforts)}",
        f"  armature: {flow(armature)}",
        f"  decimation: {int(number(param, 'decimation'))}",
        f"  history: {int(number(param, 'obs_history_length'))}",
        f"  observations: {int(number(param, 'observations_size'))}",
        f"  clip_observations: {number(param, 'clip_observations'):g}",
        f"  clip_actions: {number(param, 'clip_actions'):g}",
        f"  scale_ang_vel: {number(param, 'ang_vel'):g}",
        f"  scale_dof_pos: {number(param, 'dof_pos'):g}",
        f"  scale_dof_vel: {number(param, 'dof_vel'):g}",
        f"  max_command: [{number(param, 'max_vx'):g}, {number(param, 'max_vy'):g}, "
        f"{number(param, 'max_vz'):g}]",
    ]
    (output / "walk.yaml").write_text("\n".join(contract) + "\n")

    for notice in ("LICENSE",):
        shutil.copyfile(Path(sys.argv[1]) / notice, output / notice)
    print(f"{ROBOT}: {len(names)} joints -> {output}", file=sys.stderr)


if __name__ == "__main__":
    main()
# The humanoid stands, then walks until the run is stopped. The panel
# "Humanoid" changes the command while it walks: forward, left, turn.
scenario:
  id: walk
  description: Stand one second, then walk with the command of the panel.
  world: worlds/flat_ground.world.yaml
  seed: 1
  controller:
    behavior_tree: scenarios/walk_circle.bt.yaml

  parameters:
    stand_duration: 1.0    # s
    walk_duration: 0.0     # s, 0: walk until the run is stopped
    vx: 0.3                # m/s, forward
    vy: 0.0                # m/s, to the left
    yaw_rate: 0.3          # rad/s, counter-clockwise

  assertions:
    - { condition: "humanoid.height_min > 0.7", phase: always }
# Stand and Walk are skills of the plugin (WalkMission).
BehaviorTree:
  Sequence:
    name: WalkCircle
    children:
      - Action:
          name: Stand
      - Action:
          name: Walk
# The humanoid stands, then walks in a circle: a forward speed and a yaw
# rate draw a circle of radius vx / yaw_rate (1 m here, one turn in 21 s).
scenario:
  id: walk_circle
  description: Stand one second, then walk in a circle of one metre.
  world: worlds/flat_ground.world.yaml
  seed: 1
  controller:
    behavior_tree: scenarios/walk_circle.bt.yaml
  timeout: 40

  parameters:
    stand_duration: 1.0    # s
    walk_duration: 25.0    # s, a bit more than one turn
    vx: 0.3                # m/s, forward
    vy: 0.0                # m/s, to the left
    yaw_rate: 0.3          # rad/s, counter-clockwise

  assertions:
    - controller.success
    - { condition: "humanoid.height_min > 0.7", phase: always }
    - humanoid.turns > 1
    - humanoid.radius > 0.6
    - humanoid.radius < 1.4
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "WalkMission.hpp"

#include "Robotik/Package/Plugin/PluginAPI.hpp"
#include "Robotik/Package/Simulation.hpp"

#include <cmath>
#include <cstdio>
#include <memory>
#include <numbers>
#include <string>
#include <string_view>

/// Largest host time simulated in one update (s): a slow frame does not pile
/// up a lag the simulation never catches up.
#define MAX_LAG_S 0.05

/// Prints one or two numbers with a printf format.
static std::string format(char const* p_format, double p_a, double p_b = 0.0)
{
    char line[96];
    std::snprintf(line, sizeof(line), p_format, p_a, p_b);
    return line;
}

// ****************************************************************************
/// Humanoid walking by a learned policy. The plugin owns the clock
/// (host.clock: plugin): it steps the simulation at the physics rate of the
/// training, whatever the host rate, so the policy runs at its own rate.
/// Its panel changes the walk command while the robot walks.
// ****************************************************************************
class HumanoidWalkPlugin final: public robotik::Plugin
{
public:

    static robotik::PluginInfo describe()
    {
        return { .id = "robotik.humanoid_walk" };
    }

    RobotikPluginStatus setup(robotik::Host& p_host,
                              std::string_view p_scenario) override
    {
        m_mission.reset();
        if (p_scenario != "walk" && p_scenario != "walk_circle")
        {
            p_host.error("unknown humanoid scenario");
            return ROBOTIK_PLUGIN_ERR_SETUP;
        }
        m_mission = std::make_unique<WalkMission>();
        p_host.bindMission(*m_mission);
        p_host.addPanel("humanoid", "Humanoid", &onDraw, this);
        return ROBOTIK_PLUGIN_OK;
    }

    RobotikPluginStatus update(robotik::Host& p_host, double p_dt) override
    {
        robotik::Simulation* simulation = p_host.simulation();
        if (m_mission == nullptr || simulation == nullptr)
        {
            return ROBOTIK_PLUGIN_OK;
        }
        robotik::Seconds const step = WalkMission::physicsStep();
        m_lag = std::min(m_lag + p_dt, MAX_LAG_S);
        // The physics goes on after the end of the run, so the simulator
        // shows what follows a failure (a robot without IMU falls). The
        // verdict is already frozen; the headless host stops at the end.
        // The epsilon absorbs rounding: 0.01 s is ten steps, not nine.
        while (m_lag + 1e-9 >= step.value())
        {
            simulation->step(step);
            m_lag -= step.value();
        }
        return ROBOTIK_PLUGIN_OK;
    }

    RobotikPluginStatus shutdown(robotik::Host& /*p_host*/) override
    {
        m_mission.reset();
        return ROBOTIK_PLUGIN_OK;
    }

private:

    static void onDraw(void* p_user, RobotikCanvas const* p_canvas)
    {
        static_cast<HumanoidWalkPlugin*>(p_user)->draw(
            robotik::Canvas(p_canvas));
    }

    void draw(robotik::Canvas const& p_canvas)
    {
        if (m_mission == nullptr)
        {
            return;
        }
        // Sliders speak cm/s and deg/s; the command is SI.
        std::array<double, 3>& command = m_mission->command();
        constexpr double DEG = 180.0 / std::numbers::pi;
        int vx = static_cast<int>(std::lround(command[0] * 100.0));
        int vy = static_cast<int>(std::lround(command[1] * 100.0));
        int yaw = static_cast<int>(std::lround(command[2] * DEG));
        p_canvas.text("Walk command (applied at once)");
        if (p_canvas.sliderInt("forward cm/s", vx, -50, 50))
        {
            command[0] = vx / 100.0;
        }
        if (p_canvas.sliderInt("left cm/s", vy, -30, 30))
        {
            command[1] = vy / 100.0;
        }
        if (p_canvas.sliderInt("turn deg/s", yaw, -28, 28))
        {
            command[2] = yaw / DEG;
        }
        if (p_canvas.button("Stop"))
        {
            command = {};
        }
        p_canvas.separator();
        p_canvas.text(format(
            "Path radius %.2f m (commanded %.2f m, exact after one turn)",
            m_mission->radius(),
            m_mission->commandedRadius()));
        p_canvas.text(format("Turns %.2f   distance %.1f m",
                             m_mission->turns(),
                             m_mission->distance()));
        if (m_mission->height() < 0.6)
        {
            p_canvas.textColored(0.90F, 0.25F, 0.25F, "The robot fell: Replay");
        }
        else
        {
            p_canvas.text(format("Pelvis height %.2f m", m_mission->height()));
        }
    }

    std::unique_ptr<WalkMission> m_mission;
    /// Host time not yet simulated (s).
    double m_lag = 0.0;
};

ROBOTIK_EXPORT_PLUGIN(HumanoidWalkPlugin)
