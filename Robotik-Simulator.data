// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#pragma once

#include "WalkPolicy.hpp"

#include "Robotik/Task/Mission.hpp"
#include "Robotik/Task/Scheduler.hpp"

#include <array>
#include <memory>
#include <string>
#include <vector>

// ****************************************************************************
/// A humanoid walks by a learned policy (LimX HU_D04_01).
///
/// Setup plugs a floating-base MuJoCo backend without gravity compensation
/// (the policy was trained without it), gives every joint the PD gains of the
/// policy and registers two skills on the resource "body":
/// @li @c Stand holds the default posture (parameters.stand_duration);
/// @li @c Walk runs the policy with the command (parameters.vx, vy,
///     yaw_rate) for parameters.walk_duration.
///
/// The policy and its contract (walk.onnx, walk.yaml) sit next to the URDF
/// in the asset pack. Metrics, from the ground truth of the base link:
/// humanoid.height_min (m), humanoid.distance (m, path length in the
/// plane), humanoid.turns (yaw turned while walking, in turns),
/// humanoid.radius (m, mean distance to the centre of the walked path) and
/// humanoid.commanded_radius (m, vx / yaw_rate).
// ****************************************************************************
class WalkMission final: public robotik::Mission
{
public:

    void setup(robotik::Cell& p_cell,
               robotik::SceneView* p_view) override;
    void reset(robotik::Cell& p_cell,
               robotik::Seed p_seed) override;
    void step(robotik::Cell& p_cell, robotik::Seconds p_dt) override;
    void measure(robotik::Cell const& p_cell,
                 robotik::Metrics& p_metrics) const override;

    /// Command of the Walk skill: forward (m/s), lateral (m/s), yaw
    /// rate (rad/s). Starts from the scenario parameters; a panel may change it
    /// while the robot walks.
    [[nodiscard]] std::array<double, 3>& command()
    {
        return m_command;
    }

    /// Base link height now (m), ground truth.
    [[nodiscard]] double height() const
    {
        return m_height;
    }
    [[nodiscard]] double distance() const
    {
        return m_distance;
    }
    [[nodiscard]] double turns() const;
    [[nodiscard]] double radius() const;
    [[nodiscard]] double commandedRadius() const;

    /// Physics step of the backend: the plugin steps the simulation
    /// at this rate so the policy runs exactly every decimation steps.
    [[nodiscard]] static robotik::Seconds physicsStep();

private:

    std::unique_ptr<WalkPolicy> m_policy;
    /// Ground truth reference of the base link: "<robot id>.base_link".
    std::string m_base;
    void paintGround(robotik::SceneView& p_view);

    robotik::SkillId m_walk = robotik::NO_SKILL;
    std::array<double, 3> m_command{};

    // Episode statistics.
    double m_height = 0.0;
    double m_height_min = 0.0;
    double m_distance = 0.0;
    double m_yaw_turned = 0.0;
    double m_last_x = 0.0;
    double m_last_y = 0.0;
    double m_last_yaw = 0.0;
    double m_next_sample = 0.0;
    /// Positions while walking, to fit the circle at the end.
    std::vector<std::array<double, 2>> m_path;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "WalkPolicy.hpp"

#include "Robotik/Common/Config.hpp"

#include <onnxruntime_cxx_api.h>

#include <algorithm>
#include <stdexcept>

/// Reads a YAML sequence of numbers of the expected length.
static std::vector<double> numbers(robotik::ConfigNode const& p_node,
                                   std::string_view p_key,
                                   std::size_t p_size)
{
    std::vector<double> values;
    for (robotik::ConfigNode const& item : p_node.at(p_key).items())
    {
        std::optional<double> const value = item.asNumber();
        if (!value)
        {
            throw std::runtime_error("walk." + std::string(p_key) +
                                     ": not a number");
        }
        values.push_back(*value);
    }
    if (values.size() != p_size)
    {
        throw std::runtime_error("walk." + std::string(p_key) + ": " +
                                 std::to_string(values.size()) +
                                 " values for " + std::to_string(p_size) +
                                 " joints");
    }
    return values;
}

/// Clamps a value to a symmetric bound and returns it as float.
static float clip(double p_value, double p_bound)
{
    return static_cast<float>(std::clamp(p_value, -p_bound, p_bound));
}

// ----------------------------------------------------------------------------
WalkContract WalkContract::load(std::filesystem::path const& p_path)
{
    robotik::Result<robotik::ConfigNode> loaded = robotik::ConfigNode::load(p_path);
    if (!loaded)
    {
        throw std::runtime_error(loaded.error());
    }
    robotik::ConfigNode const root = loaded.take();
    robotik::ConfigNode const& walk = root.at("walk");

    WalkContract contract;
    contract.joints = walk.strings("joints");
    std::size_t const count = contract.joints.size();
    contract.kp = numbers(walk, "kp", count);
    contract.kd = numbers(walk, "kd", count);
    contract.default_angle = numbers(walk, "default_angle", count);
    contract.action_scale = numbers(walk, "action_scale", count);
    contract.torque_limit = numbers(walk, "torque_limit", count);
    contract.armature = numbers(walk, "armature", count);
    contract.decimation =
        static_cast<int>(walk.number("decimation", contract.decimation));
    contract.history =
        static_cast<int>(walk.number("history", contract.history));
    contract.observations =
        static_cast<int>(walk.number("observations", contract.observations));
    contract.clip_observations =
        walk.number("clip_observations", contract.clip_observations);
    contract.clip_actions = walk.number("clip_actions", contract.clip_actions);
    contract.scale_ang_vel =
        walk.number("scale_ang_vel", contract.scale_ang_vel);
    contract.scale_dof_pos =
        walk.number("scale_dof_pos", contract.scale_dof_pos);
    contract.scale_dof_vel =
        walk.number("scale_dof_vel", contract.scale_dof_vel);
    std::vector<double> const command = numbers(walk, "max_command", 3U);
    std::ranges::copy(command, contract.max_command.begin());

    if (contract.observations != static_cast<int>(9U + 3U * count))
    {
        throw std::runtime_error("walk.observations must be 9 + 3 x joints");
    }
    return contract;
}

// ****************************************************************************
struct WalkPolicy::Onnx
{
    explicit Onnx(std::filesystem::path const& p_model)
        : env(ORT_LOGGING_LEVEL_WARNING, "robotik_humanoid_walk"),
          session(env, p_model.c_str(), options()),
          memory(
              Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault))
    {
        Ort::AllocatorWithDefaultOptions allocator;
        input = session.GetInputNameAllocated(0, allocator).get();
        output = session.GetOutputNameAllocated(0, allocator).get();
    }

    static Ort::SessionOptions options()
    {
        // One thread: the step is a few microseconds and runs in the
        // simulation loop, next to parallel environments.
        Ort::SessionOptions options;
        options.SetIntraOpNumThreads(1);
        options.SetInterOpNumThreads(1);
        return options;
    }

    Ort::Env env;
    Ort::Session session;
    Ort::MemoryInfo memory;
    std::string input;
    std::string output;
};

// ----------------------------------------------------------------------------
WalkPolicy::WalkPolicy(std::filesystem::path const& p_model,
                       WalkContract p_contract)
    : m_contract(std::move(p_contract))
{
    try
    {
        m_onnx = std::make_unique<Onnx>(p_model);
    }
    catch (Ort::Exception const& e)
    {
        throw std::runtime_error("Walk policy '" + p_model.string() +
                                 "': " + e.what());
    }
    std::size_t const count = m_contract.joints.size();
    m_history.assign(
        static_cast<std::size_t>(m_contract.history * m_contract.observations),
        0.0F);
    m_actions.assign(count, 0.0F);
    m_targets.assign(m_contract.default_angle.begin(),
                     m_contract.default_angle.end());
}

WalkPolicy::~WalkPolicy() = default;

// ----------------------------------------------------------------------------
void WalkPolicy::reset()
{
    std::ranges::fill(m_history, 0.0F);
    std::ranges::fill(m_actions, 0.0F);
    m_targets.assign(m_contract.default_angle.begin(),
                     m_contract.default_angle.end());
    m_fresh = true;
}

// ----------------------------------------------------------------------------
void WalkPolicy::observe(WalkInput const& p_input)
{
    WalkContract const& c = m_contract;
    std::size_t const count = c.joints.size();
    std::size_t const size = static_cast<std::size_t>(c.observations);
    std::vector<float> obs;
    obs.reserve(size);

    // Gravity seen from the IMU: the policy reads the tilt from it.
    robotik::Vector3 const gravity =
        p_input.orientation.conjugate() * robotik::Vector3(0.0, 0.0, -1.0);
    robotik::Vector3 const& w = p_input.angular_velocity;
    for (double v : { w.x, w.y, w.z })
    {
        obs.push_back(clip(v * c.scale_ang_vel, c.clip_observations));
    }
    for (double v : { gravity.x, gravity.y, gravity.z })
    {
        obs.push_back(clip(v, c.clip_observations));
    }
    for (double v : p_input.command)
    {
        obs.push_back(clip(v, c.clip_observations));
    }
    for (std::size_t i = 0; i < count; ++i)
    {
        obs.push_back(
            clip((p_input.positions[i] - c.default_angle[i]) * c.scale_dof_pos,
                 c.clip_observations));
    }
    for (std::size_t i = 0; i < count; ++i)
    {
        obs.push_back(
            clip(p_input.velocities[i] * c.scale_dof_vel, c.clip_observations));
    }
    obs.insert(obs.end(), m_actions.begin(), m_actions.end());

    // Newest first. The first observation fills the whole history.
    if (m_fresh)
    {
        for (std::size_t k = 0; k < static_cast<std::size_t>(c.history); ++k)
        {
            std::ranges::copy(obs,
                              m_history.begin() + static_cast<long>(k * size));
        }
        m_fresh = false;
        return;
    }
    std::copy_backward(m_history.begin(),
                       m_history.end() - static_cast<long>(size),
                       m_history.end());
    std::ranges::copy(obs, m_history.begin());
}

// ----------------------------------------------------------------------------
std::span<double const> WalkPolicy::act(WalkInput const& p_input)
{
    WalkContract const& c = m_contract;
    observe(p_input);

    std::array<int64_t, 2> const shape{
        1, static_cast<int64_t>(m_history.size())
    };
    Ort::Value input = Ort::Value::CreateTensor<float>(m_onnx->memory,
                                                       m_history.data(),
                                                       m_history.size(),
                                                       shape.data(),
                                                       shape.size());
    char const* const inputs[] = { m_onnx->input.c_str() };
    char const* const outputs[] = { m_onnx->output.c_str() };
    std::vector<Ort::Value> result = m_onnx->session.Run(
        Ort::RunOptions{ nullptr }, inputs, &input, 1U, outputs, 1U);

    float const* const actions = result.front().GetTensorData<float>();
    for (std::size_t i = 0; i < m_actions.size(); ++i)
    {
        m_actions[i] = clip(actions[i], c.clip_actions);
        m_targets[i] = static_cast<double>(m_actions[i]) * c.action_scale[i] +
                       c.default_angle[i];
    }
    return m_targets;
}
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#pragma once

#include "Robotik/Common/Math.hpp"

#include <array>
#include <filesystem>
#include <memory>
#include <span>
#include <string>
#include <vector>

// ****************************************************************************
/// What the walking policy expects, read from walk.yaml (written by
/// prepare_assets.py from the LimX deployment config). One entry per joint,
/// in the order of the policy.
// ****************************************************************************
struct WalkContract
{
    std::vector<std::string> joints;
    std::vector<double> kp;
    std::vector<double> kd;
    std::vector<double> default_angle;
    std::vector<double> action_scale;
    std::vector<double> torque_limit;
    std::vector<double> armature;
    /// Physics steps per policy step.
    int decimation = 10;
    /// Observations stacked at the policy input, newest first.
    int history = 5;
    int observations = 102;
    double clip_observations = 100.0;
    double clip_actions = 100.0;
    double scale_ang_vel = 0.25;
    double scale_dof_pos = 1.0;
    double scale_dof_vel = 0.05;
    /// Largest |vx| (m/s), |vy| (m/s), |yaw rate| (rad/s).
    std::array<double, 3> max_command{ 0.5, 0.3, 0.5 };

    /// @throws std::runtime_error on a missing or inconsistent field.
    [[nodiscard]] static WalkContract load(std::filesystem::path const& p_path);
};

// ****************************************************************************
/// What the robot measures, as the policy wants it.
// ****************************************************************************
struct WalkInput
{
    /// IMU attitude in the world frame.
    robotik::Quaternion orientation;
    /// IMU angular velocity in the IMU frame (rad/s).
    robotik::Vector3 angular_velocity = robotik::Vector3::ZERO;
    /// Command: forward (m/s), lateral (m/s), yaw rate (rad/s).
    std::array<double, 3> command{};
    /// Joint positions and velocities, policy order.
    std::span<double const> positions;
    std::span<double const> velocities;
};

// ****************************************************************************
/// LimX walking policy (ONNX, 31 joints): observation history in,
/// joint position targets out. Plain C++ over ONNX Runtime; it knows nothing
/// of the simulation.
///
/// Observation (102): angular velocity, projected gravity, command, joint
/// positions minus the default posture, joint velocities, last actions.
/// Target of joint i: action_i * action_scale_i + default_angle_i.
// ****************************************************************************
class WalkPolicy
{
public:

    /// @throws std::runtime_error if the model or its contract cannot be read.
    WalkPolicy(std::filesystem::path const& p_model, WalkContract p_contract);
    ~WalkPolicy();

    [[nodiscard]] WalkContract const& contract() const
    {
        return m_contract;
    }

    /// Forgets the history and the last actions (new episode).
    void reset();

    /// Runs the network once and returns one target per joint (rad).
    [[nodiscard]] std::span<double const> act(WalkInput const& p_input);

private:

    void observe(WalkInput const& p_input);

    struct Onnx;
    std::unique_ptr<Onnx> m_onnx;
    WalkContract m_contract;
    std::vector<float> m_history;
    std::vector<float> m_actions;
    std::vector<double> m_targets;
    bool m_fresh = true;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "WalkSkills.hpp"

#include "Robotik/Robot/Robot.hpp"
#include "Robotik/Task/RobotContext.hpp"
#include "Robotik/Robot/Sensors/Imu.hpp"

#include <algorithm>

/// Gravity along the IMU z axis above which the robot lies down (upright: -1).
#define FALLEN_GRAVITY_Z -0.5

/// Damping mode of the LimX controllers: no stiffness, a viscous brake
/// (JointGains::velocity_kp = kd). Without its IMU the robot cannot balance:
/// it sags to the ground instead of freezing in a stiff pose.
static void damp(robotik::JointSet& p_joints,
                 std::vector<robotik::JointId> const& p_ids)
{
    for (robotik::JointId const id : p_ids)
    {
        p_joints.spin(id, 0.0);
    }
}

// ****************************************************************************
StandSkill::StandSkill(WalkBody p_body,
                       std::vector<double> p_posture,
                       robotik::Seconds p_duration)
    : m_body(std::move(p_body)),
      m_posture(std::move(p_posture)),
      m_duration(p_duration)
{
}

void StandSkill::reset()
{
    m_elapsed = robotik::Seconds{};
}

robotik::Status StandSkill::tick(robotik::RobotContext& p_context, robotik::Seconds p_dt)
{
    robotik::JointSet& joints = p_context.robot.joints();
    for (std::size_t i = 0; i < m_body.joints.size(); ++i)
    {
        joints.moveTo(m_body.joints[i], m_posture[i]);
    }
    m_elapsed = m_elapsed + p_dt;
    return m_elapsed >= m_duration ? robotik::Status::SUCCESS
                                   : robotik::Status::RUNNING;
}

void StandSkill::cancel(robotik::RobotContext& p_context)
{
    p_context.robot.joints().hold();
}

// ****************************************************************************
WalkSkill::WalkSkill(WalkBody p_body,
                     WalkPolicy& p_policy,
                     std::array<double, 3> const& p_command,
                     robotik::Seconds p_duration,
                     robotik::Seconds p_period)
    : m_body(std::move(p_body)),
      m_policy(p_policy),
      m_command(p_command),
      m_duration(p_duration),
      m_period(p_period),
      m_positions(m_body.joints.size()),
      m_velocities(m_body.joints.size())
{
}

void WalkSkill::reset()
{
    m_policy.reset();
    m_elapsed = robotik::Seconds{};
    m_wait = robotik::Seconds{};
}

robotik::Status WalkSkill::tick(robotik::RobotContext& p_context, robotik::Seconds p_dt)
{
    robotik::Robot& robot = p_context.robot;
    auto const* imu = robot.sensors().find<robotik::Imu>(m_body.imu);
    if (imu == nullptr || !imu->reading().valid)
    {
        damp(robot.joints(), m_body.joints);
        return robotik::Status::FAILURE;
    }
    robotik::ImuReading const& reading = imu->reading();
    robotik::Vector3 const gravity =
        reading.orientation.conjugate() * robotik::Vector3(0.0, 0.0, -1.0);
    if (gravity.z > FALLEN_GRAVITY_Z)
    {
        damp(robot.joints(), m_body.joints);
        return robotik::Status::FAILURE;
    }

    m_wait = m_wait - p_dt;
    if (m_wait.value() <= 1e-9)
    {
        m_wait = m_wait + m_period;
        robotik::JointSet& joints = robot.joints();
        for (std::size_t i = 0; i < m_body.joints.size(); ++i)
        {
            m_positions[i] = joints.position(m_body.joints[i]);
            m_velocities[i] = joints.velocity(m_body.joints[i]);
        }
        std::array<double, 3> command{};
        std::array<double, 3> const& limit = m_policy.contract().max_command;
        for (std::size_t i = 0; i < command.size(); ++i)
        {
            command[i] = std::clamp(m_command[i], -limit[i], limit[i]);
        }
        WalkInput const input{ reading.orientation,
                               reading.angular_velocity,
                               command,
                               m_positions,
                               m_velocities };
        std::span<double const> const targets = m_policy.act(input);
        for (std::size_t i = 0; i < m_body.joints.size(); ++i)
        {
            joints.moveTo(m_body.joints[i], targets[i]);
        }
    }

    m_elapsed = m_elapsed + p_dt;
    bool const done = m_duration.value() > 0.0 && m_elapsed >= m_duration;
    return done ? robotik::Status::SUCCESS : robotik::Status::RUNNING;
}

void WalkSkill::cancel(robotik::RobotContext& p_context)
{
    p_context.robot.joints().hold();
}
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#pragma once

#include "WalkPolicy.hpp"

#include "Robotik/Robot/Joints.hpp"
#include "Robotik/Task/Skills/Skill.hpp"

#include <array>
#include <string>
#include <vector>

// ****************************************************************************
/// Joints of the policy, in its order, and the IMU that feeds it.
// ****************************************************************************
struct WalkBody
{
    std::vector<robotik::JointId> joints;
    std::string imu;
};

// ****************************************************************************
/// Holds the default posture of the policy for a while: the robot
/// settles on its feet before walking.
// ****************************************************************************
class StandSkill final: public robotik::Skill
{
public:

    StandSkill(WalkBody p_body,
               std::vector<double> p_posture,
               robotik::Seconds p_duration);

    void reset() override;
    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

private:

    WalkBody m_body;
    std::vector<double> m_posture;
    robotik::Seconds m_duration;
    robotik::Seconds m_elapsed{};
};

// ****************************************************************************
/// Walks with a velocity command for a while (forever when the
/// duration is not positive). A forward speed and a yaw rate draw a circle of
/// radius vx / yaw rate. The command is read at each policy run: a panel may
/// change it while the robot walks.
///
/// The policy runs every decimation physics steps on the IMU and the joint
/// encoders; between two runs the joint PD loops hold its targets. The skill
/// fails when the IMU is lost or says the robot lies down; it then leaves the
/// joints in damping mode (velocity loop toward zero), as the LimX robot does.
// ****************************************************************************
class WalkSkill final: public robotik::Skill
{
public:

    WalkSkill(WalkBody p_body,
              WalkPolicy& p_policy,
              std::array<double, 3> const& p_command,
              robotik::Seconds p_duration,
              robotik::Seconds p_period);

    void reset() override;
    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

private:

    WalkBody m_body;
    WalkPolicy& m_policy;
    /// Forward (m/s), lateral (m/s), yaw rate (rad/s), owned by the mission.
    std::array<double, 3> const& m_command;
    robotik::Seconds m_duration;
    /// Time between two policy runs.
    robotik::Seconds m_period;
    robotik::Seconds m_elapsed{};
    robotik::Seconds m_wait{};
    std::vector<double> m_positions;
    std::vector<double> m_velocities;
};
# A LimX HU_D04_01 humanoid (1.6 m, 47 kg, 31 joints) standing on a flat
# floor. Only the feet collide. Z-up, metres, radians.
world:
  id: flat_ground
  floor: { friction: 1.0 }
  entities:
    - id: humanoid
      type: robot
      model: robotik.limx.hu_d04_01
      # Feet on the floor in the home posture, facing +x: a left turn of
      # 1 m radius circles the origin.
      pose: { position: [0.0, -1.0, 0.905] }
      # Default posture of the walking policy (walk.yaml default_angle).
      home:
        left_hip_pitch_joint: -0.15
        left_hip_roll_joint: 0.0
        left_hip_yaw_joint: -0.05
        left_knee_joint: 0.3
        left_ankle_pitch_joint: -0.16
        left_ankle_roll_joint: 0.0
        right_hip_pitch_joint: -0.15
        right_hip_roll_joint: 0.0
        right_hip_yaw_joint: 0.05
        right_knee_joint: 0.3
        right_ankle_pitch_joint: -0.16
        right_ankle_roll_joint: 0.0
        left_shoulder_pitch_joint: 0.1
        left_shoulder_roll_joint: 0.1
        left_shoulder_yaw_joint: -0.2
        left_elbow_joint: -0.2
        right_shoulder_pitch_joint: 0.1
        right_shoulder_roll_joint: -0.1
        right_shoulder_yaw_joint: 0.2
        right_elbow_joint: -0.2
      sensors:
        # On the pelvis, as on the real robot. Sampled at the physics rate:
        # the angular velocity is a finite difference of the attitude.
        imu: { type: imu, parent: base_link, frequency: 1000 }
      actuators:
        # Every joint: the resource reserved by the Stand and Walk skills.
        body: { type: joint_group }
