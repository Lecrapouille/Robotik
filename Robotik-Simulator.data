# One rendered environment. The policy starts converged, or random and
# converts toward the recipe. The parallel pool stays in
# Robotik-PickAndPlaceRL. The plugin advances the clock itself.
scenario:
  id: pick_and_place_rl
  description: Reach, grasp and deliver the red cube with a learned policy.
  world: worlds/pick_place_rl_cell.world.yaml
  seed: 42
  timeout: 150

  assertions:
    - time < 200
scenario:
  id: pick_and_place
  description: Pick the red cube and put it in the box.
  world: worlds/pick_place_cell.world.yaml
  # Master seed: prop layout, sensor noise and random faults derive from it.
  seed: 42

  controller:
    behavior_tree: scenarios/pick_and_place.bt.yaml

  # Headless runs render no image: the true cube pose stands in for the
  # camera there. The simulator renders it and uses real perception.
  perception: { blind: truth }   # true poses when no camera has an image

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 30
# The workflow of the pick and place cell: who works, on what, how long.
# Robotik-Headless reads it and prints the cycle time, the throughput and the
# critical circuit (the bottleneck) without running the robot:
#   ./build/Robotik-Headless build/plugins/PickAndPlace/scenarios/pick_and_place.workflow.yaml
# The durations come from a run of pick_and_place.scenario.yaml.
workflow:
  id: pick_and_place_line
  operators:                    # in the order the products visit them
    - { id: camera, entity: robot }
    - { id: arm, entity: robot }
    - { id: gripper, entity: vacuum }
  products:
    - id: red_cube
      count: 1                  # cubes in the cell at once
      route:
        - { name: detect, on: camera, skill: "Detect(red_cube)", duration: 0.05 }
        - { name: approach and reach, on: arm, duration: 2.9 }
        - { name: grasp and carry, on: gripper, duration: 2.1 }
# Same mission with camera failures. A failure is only an unavailable
# resource: Detect fails until the camera is repaired (the tree retries it),
# then the camera fails for good and the robot goes on from its world model.
scenario:
  id: pick_and_place_faults
  description: Pick the red cube and put it in the box, with a camera failure.
  world: worlds/pick_place_cell.world.yaml
  seed: 7

  controller:
    behavior_tree: scenarios/pick_and_place.bt.yaml

  # Headless runs render no image: the true cube pose stands in for the
  # camera there. The simulator renders it and uses real perception.
  perception: { blind: truth }   # true poses when no camera has an image

  faults:
    - { at: 0.0, resource: wrist_camera, action: disable }
    - { at: 1.0, resource: wrist_camera, action: restore }
    - { at: 3.0, resource: wrist_camera, action: disable }
    # Random failures: mean rate per second.
    # - { resource: gripper, rate: 0.01 }

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 30
