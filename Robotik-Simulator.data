# A GEMMA (start and stop modes of a machine) of three graphs:
# - Safety: Normal, or D1 Emergency stop (Stop skill, forces Control and
#   Production to their initial steps) while AU is pressed, until Rearm;
# - Control: A1 Initial stop, F1 Production after a rising edge of Dcy,
#   A2 End of cycle;
# - Production: one pick and place cycle while Control is in F1.
# The operator presses Dcy at the start: one cycle, then back to A1.
scenario:
  id: pick_and_place_gemma
  description: One production cycle started by the Dcy button of a GEMMA.
  world: worlds/pick_place_cell.world.yaml
  seed: 42

  controller:
    grafcet:
      file: scenarios/pick_and_place_gemma.grafcet.json
      # Back in A1 after one second at least in F1 (and until 1000 s after).
      success: Control:X0 . 1s/Control:X1/1000s
      events:
        - { at: 0.0, input: Dcy, pulse: true }   # the operator pushes Dcy

  perception: { blind: truth }   # true poses when no camera has an image

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 30
# The GEMMA of pick_and_place_gemma.scenario.yaml: the emergency stop AU is
# pressed during the approach, released, the operator rearms (Rearm) and
# starts a new cycle (Dcy). Dcy and Rearm are push buttons (one cycle at 1,
# their rising edge counts); AU is a latched button.
scenario:
  id: pick_and_place_gemma_rearm
  description: Emergency stop, rearm and restart of a GEMMA.
  world: worlds/pick_place_cell.world.yaml
  seed: 42

  controller:
    grafcet:
      file: scenarios/pick_and_place_gemma.grafcet.json
      # Back in A1 after a full production cycle (5 s at least in F1): the
      # first cycle, stopped after 1 s, does not count.
      success: Control:X0 . Safety:X0 . 5s/Control:X1/1000s
      events:
        - { at: 0.0, input: Dcy, pulse: true }
        - { at: 1.0, input: AU, value: 1 }      # emergency stop
        - { at: 2.0, input: AU, value: 0 }      # released
        - { at: 2.5, input: Rearm, pulse: true }
        - { at: 3.0, input: Dcy, pulse: true }  # new cycle

  perception: { blind: truth }   # true poses when no camera has an image

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 30
# The GEMMA of pick_and_place_gemma.scenario.yaml, with the emergency stop
# button AU pressed during the cycle: Safety goes to D1, stops the robot and
# forces Control and Production back to their initial steps.
scenario:
  id: pick_and_place_gemma_stop
  description: Emergency stop of a GEMMA during the production cycle.
  world: worlds/pick_place_cell.world.yaml
  seed: 42

  controller:
    grafcet:
      file: scenarios/pick_and_place_gemma.grafcet.json
      # In D1 for two seconds, Control held in A1 by the forcing.
      success: Safety:X1 . 2s/Safety:X1 . Control:X0 . Production:X0
      events:
        - { at: 0.0, input: Dcy, pulse: true }   # push button
        - { at: 3.0, input: AU, value: 1 }

  perception: { blind: truth }   # true poses when no camera has an image

  timeout: 30

  assertions:
    - controller.success
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 10
# The pick and place of pick_and_place_faults.scenario.yaml, driven by a
# GRAFCET (IEC 60848 chart, drawn with TimedPetriNetEditor) instead of a
# behavior tree. Each step requests a skill (its action); each transition
# waits for done(Skill) or reads a belief (holding(red_cube)). When the
# camera is lost, failed(Detect(red_cube)) leads to a Retry step that waits
# 500 ms (500ms/X2) before detecting again.
scenario:
  id: pick_and_place_grafcet
  description: Pick the red cube and put it in the box, driven by a GRAFCET, with a camera failure.
  world: worlds/pick_place_cell.world.yaml
  seed: 7

  controller:
    grafcet:
      file: scenarios/pick_and_place.grafcet.json
      success: X11              # the End step

  # Headless runs render no image: the true cube pose stands in for the
  # camera there. The simulator renders it and uses real perception.
  perception: { blind: truth }   # true poses when no camera has an image

  faults:
    - { at: 0.0, resource: wrist_camera, action: disable }
    - { at: 1.0, resource: wrist_camera, action: restore }

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - time < 30
# The same task as pick_and_place.scenario.yaml, with no behavior tree: the PDDL
# planner finds the steps from the goal. The domain lists the actions; the
# world gives the objects (entities with a kind); the mission reads the
# state on the beliefs and runs each action with its skills.
scenario:
  id: pick_and_place_pddl
  description: Plan how to put the red cube in the box, then do it.
  world: worlds/pick_place_cell.world.yaml
  seed: 42

  controller:
    planner:
      domain: scenarios/pick_and_place.domain.pddl
      goal:
        - in(red_cube, box)

  # Headless runs render no image: the true cube pose stands in for the
  # camera there. The simulator renders it and uses real perception.
  perception: { blind: truth }   # true poses when no camera has an image

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - planner.replans == 0
    - time < 30
# The planner against a camera failure. Detect fails while the camera is
# down: the executor waits replan.delay (simulated seconds) and plans again
# from what the robot believes. Once the cube is seen, the camera fails for
# good and the robot goes on from its world model: an effect it can no
# longer observe is unknown, not false.
scenario:
  id: pick_and_place_pddl_faults
  description: Plan and put the red cube in the box, with a camera failure.
  world: worlds/pick_place_cell.world.yaml
  seed: 7

  controller:
    planner:
      domain: scenarios/pick_and_place.domain.pddl
      goal:
        - in(red_cube, box)
      replan: { max: 5, delay: 0.5 }

  perception: { blind: truth }   # true poses when no camera has an image

  faults:
    - { at: 0.0, resource: wrist_camera, action: disable }
    - { at: 1.0, resource: wrist_camera, action: restore }
    - { at: 3.0, resource: wrist_camera, action: disable }

  timeout: 60

  assertions:
    - controller.success
    - inside(red_cube, box)
    - holding(gripper) == 0
    - { condition: "collision_count(robot) == 0", phase: always }
    - planner.replans >= 1
    - time < 30
