/// @file ConveyorMission.hpp
/// Two arms and a conveyor: the skills of each robot, the observers
/// and bindings of the PDDL domain, and the belt.
#pragma once

#include "Conveyor.hpp"

#include "Robotik/Robot/Robot.hpp"
#include "Robotik/Task/Mission.hpp"

#include <string>
#include <vector>

namespace dual_arm
{

// ****************************************************************************
/// Mission of the conveyor scenarios. Publishes @c dual_arm.overlap:
/// simulated seconds during which both arms ran a skill.
// ****************************************************************************
class ConveyorMission final: public robotik::Mission
{
public:

    void setup(robotik::Cell& p_cell,
               robotik::SceneView* p_view) override;
    void reset(robotik::Cell& p_cell,
               robotik::Seed p_seed) override;
    void step(robotik::Cell& p_cell, robotik::Seconds p_dt) override;
    void measure(robotik::Cell const& p_cell,
                 robotik::Metrics& p_metrics) const override;

private:

    void addArmSkills(robotik::Cell& p_cell,
                      robotik::Robot const& p_robot);
    void addPlanning(robotik::Cell& p_cell);

private:

    Conveyor m_conveyor;
    /// World entities of each kind (ids).
    std::vector<std::string> m_parts;
    std::vector<std::string> m_feeders;
    std::vector<std::string> m_zones;
    std::vector<std::string> m_bins;
    double m_overlap = 0.0;
};

} // namespace dual_arm
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

// Two arms in one cell, planned by PDDL. The same mission runs both
// conveyor scenarios: only planner.parallel differs. The tray scenario
// plans with durative actions.

#include "ConveyorMission.hpp"
#include "TrayMission.hpp"

#include "Robotik/Package/Plugin/PluginAPI.hpp"

#include <memory>
#include <string_view>

/// Loads the mission chosen by the scenario.
class DualArmPlugin final: public robotik::Plugin
{
public:

    static robotik::PluginInfo describe()
    {
        return { .id = "robotik.dual_arm" };
    }

    RobotikPluginStatus setup(robotik::Host& p_host,
                              std::string_view p_scenario) override
    {
        if (p_scenario == "conveyor" || p_scenario == "conveyor_sequential" ||
            p_scenario == "conveyor_grafcet" || p_scenario == "factory")
        {
            m_mission = std::make_unique<dual_arm::ConveyorMission>();
            p_host.bindMission(*m_mission);
            return ROBOTIK_PLUGIN_OK;
        }
        if (p_scenario == "tray")
        {
            m_mission = std::make_unique<dual_arm::TrayMission>();
            p_host.bindMission(*m_mission);
            return ROBOTIK_PLUGIN_OK;
        }
        p_host.error("unknown dual arm scenario");
        return ROBOTIK_PLUGIN_ERR_SETUP;
    }

    RobotikPluginStatus shutdown(robotik::Host& /*p_host*/) override
    {
        m_mission.reset();
        return ROBOTIK_PLUGIN_OK;
    }

private:

    std::unique_ptr<robotik::Mission> m_mission;
};

ROBOTIK_EXPORT_PLUGIN(DualArmPlugin)
