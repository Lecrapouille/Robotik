/// @file PainterScene.hpp
/// Conventions of the painter demonstration.
///
/// The world (worlds/painting_lab.world.yaml) builds the easel, the canvas and
/// the pots; the strokes are trajectories of the scenario, in the frame of the
/// easel. What is left here are the entity ids, the brush orientation over a
/// pot and the paint colours. Frames are URDF Z-up, the world frame.
#pragma once

#include "Robotik/Common/Math.hpp"

#include <cmath>
#include <set>
#include <string>
#include <string_view>

namespace painter
{

/// World entity ids.
inline constexpr char const* CANVAS = "canvas";
inline constexpr char const* EASEL = "easel";

/// Tool straight down, for dipping into a pot.
inline robotik::Quaternion brushDown()
{
    return { 0.0, 0.0, 1.0, 0.0 };
}

/// Shared with the mission so a stroke can tint the canvas texture.
/// @c brush and @c painted are the memory of the robot (it cannot see the
/// paint): set by the gestures that succeed, read by the planner.
struct Stroke
{
    std::string color = "red";
    bool painting = false;
    /// Colour on the brush, empty when clean.
    std::string brush;
    /// Colours already laid on the canvas.
    std::set<std::string, std::less<>> painted;
};

inline int colorIndex(std::string_view p_name)
{
    if (p_name == "red")
    {
        return 0;
    }
    if (p_name == "black")
    {
        return 1;
    }
    if (p_name == "blue")
    {
        return 2;
    }
    return 3;
}

inline void
colorRgb(std::string_view p_name, float& p_r, float& p_g, float& p_b)
{
    switch (colorIndex(p_name))
    {
        case 0:
            p_r = 0.82F;
            p_g = 0.18F;
            p_b = 0.18F;
            break;
        case 1:
            p_r = 0.08F;
            p_g = 0.08F;
            p_b = 0.10F;
            break;
        case 2:
            p_r = 0.10F;
            p_g = 0.22F;
            p_b = 0.62F;
            break;
        default:
            p_r = 0.86F;
            p_g = 0.67F;
            p_b = 0.16F;
            break;
    }
}

} // namespace painter
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "PainterSkills.hpp"

#include "Robotik/Task/Perception/WorldModel.hpp"
#include "Robotik/Task/RobotContext.hpp"
#include "Robotik/Task/Scheduler.hpp"

#include <cmath>
#include <memory>
#include <numbers>

namespace painter
{

/// Advances along a polyline, one MoveTCP step at a time.
static robotik::Status follow(std::vector<robotik::Pose> const& p_path,
                              std::size_t& p_index,
                              robotik::MoveTCPSkill& p_move,
                              robotik::RobotContext& p_context,
                              robotik::Seconds p_dt)
{
    if (p_index >= p_path.size())
    {
        return robotik::Status::SUCCESS;
    }
    robotik::Status const status = p_move.tick(p_context, p_dt);
    if (status == robotik::Status::RUNNING)
    {
        return status;
    }
    if (status == robotik::Status::FAILURE)
    {
        return status;
    }
    ++p_index;
    if (p_index >= p_path.size())
    {
        return robotik::Status::SUCCESS;
    }
    p_move.goal(p_path[p_index]);
    return robotik::Status::RUNNING;
}

/// One stroke of the painter: dip, mark or rinse.
enum class Gesture
{
    Dip,
    Mark,
    Rinse,
};

/// Behavior-tree leaf that plays one painter gesture.
class GestureNode final: public bt::CallbackLeaf
{
public:

    GestureNode(robotik::SkillScheduler& p_scheduler,
                robotik::SkillId p_id,
                Gesture p_gesture)
        : CallbackLeaf([]() noexcept { return bt::Status::FAILURE; }),
          m_scheduler(p_scheduler),
          m_id(p_id),
          m_gesture(p_gesture)
    {
    }

    void fillConfig(bt::NodeConfig& p_config) const override
    {
        GestureNode* self = const_cast<GestureNode*>(this);
        p_config.callback = [self]() { return self->onTick(); };
        p_config.on_reset = [self]()
        {
            if (self->m_active)
            {
                self->m_scheduler.cancel(self->m_id);
                self->m_active = false;
            }
        };
    }

private:

    bt::Status onTick()
    {
        if (!m_active)
        {
            if (m_gesture != Gesture::Rinse)
            {
                auto const color = blackboard()
                                       ? blackboard()->get<std::string>("color")
                                       : std::nullopt;
                if (!color || color->empty())
                {
                    return bt::Status::FAILURE;
                }
                if (m_gesture == Gesture::Dip)
                {
                    dynamic_cast<DipSkill&>(m_scheduler.skill(m_id))
                        .use(*color);
                }
                else
                {
                    dynamic_cast<MarkSkill&>(m_scheduler.skill(m_id))
                        .use(*color);
                }
            }
            m_scheduler.request(m_id);
            m_active = true;
            return bt::Status::RUNNING;
        }
        switch (m_scheduler.state(m_id))
        {
            case robotik::SkillState::Idle:
            case robotik::SkillState::Waiting:
            case robotik::SkillState::Running:
                return bt::Status::RUNNING;
            case robotik::SkillState::Succeeded:
                m_active = false;
                return bt::Status::SUCCESS;
            case robotik::SkillState::Failed:
            case robotik::SkillState::Cancelled:
                m_active = false;
                return bt::Status::FAILURE;
        }
        return bt::Status::FAILURE;
    }

    robotik::SkillScheduler& m_scheduler;
    robotik::SkillId m_id = robotik::NO_SKILL;
    Gesture m_gesture = Gesture::Dip;
    bool m_active = false;
};

DipSkill::DipSkill(Stroke& p_stroke) : m_stroke(&p_stroke) {}

void DipSkill::use(std::string p_color)
{
    m_color = std::move(p_color);
}

void DipSkill::reset()
{
    m_path.clear();
    m_index = 0;
    m_ready = false;
    m_move.reset();
    m_stroke->painting = false;
}

robotik::Status DipSkill::tick(robotik::RobotContext& p_context,
                               robotik::Seconds p_dt)
{
    if (!m_ready)
    {
        robotik::WorldObject const* pot = p_context.world_model.find(m_color);
        if (pot == nullptr)
        {
            return robotik::Status::FAILURE;
        }
        robotik::Quaternion const down = brushDown();
        double const top = robotik::top(*pot);
        m_path = {
            { { pot->position.x, pot->position.y, top + 0.20 }, down },
            { { pot->position.x, pot->position.y, top - 0.01 }, down },
            { { pot->position.x, pot->position.y, top + 0.20 }, down },
        };
        m_move = robotik::MoveTCPSkill({}, m_path.front(), 2e-2);
        m_ready = true;
    }
    robotik::Status const status =
        follow(m_path, m_index, m_move, p_context, p_dt);
    if (status == robotik::Status::SUCCESS)
    {
        m_stroke->brush = m_color;
    }
    return status;
}

void DipSkill::cancel(robotik::RobotContext& p_context)
{
    m_stroke->painting = false;
    m_move.cancel(p_context);
}

MarkSkill::MarkSkill(Stroke& p_stroke, Strokes p_strokes, Settings p_settings)
    : m_stroke(&p_stroke),
      m_strokes(std::move(p_strokes)),
      m_settings(p_settings)
{
}

void MarkSkill::use(std::string p_color)
{
    m_color = std::move(p_color);
    m_stroke->color = m_color;
}

void MarkSkill::reset()
{
    m_path.clear();
    m_index = 0;
    m_ready = false;
    m_move.reset();
    m_stroke->painting = false;
}

robotik::Status MarkSkill::tick(robotik::RobotContext& p_context,
                                robotik::Seconds p_dt)
{
    if (!m_ready)
    {
        auto const stroke = m_strokes.find(m_color);
        if (stroke == m_strokes.end() || stroke->second.size() < 3U)
        {
            return robotik::Status::FAILURE;
        }
        // Straight lines in Cartesian space: cut each segment into small
        // steps, each one solved by IK.
        std::vector<robotik::Pose> const& points = stroke->second;
        m_path.assign(1U, points.front());
        for (std::size_t i = 1; i < points.size(); ++i)
        {
            robotik::Vector3 const from = points[i - 1].position;
            robotik::Vector3 const to = points[i].position;
            double const length = (to - from).norm();
            std::size_t const steps =
                m_settings.step > 0.0
                    ? std::max<std::size_t>(1U,
                                            static_cast<std::size_t>(std::ceil(
                                                length / m_settings.step)))
                    : 1U;
            for (std::size_t k = 1; k <= steps; ++k)
            {
                double const t =
                    static_cast<double>(k) / static_cast<double>(steps);
                m_path.push_back(robotik::Pose{ from + (to - from) * t,
                                                points[i].rotation });
            }
            if (i == 1U)
            {
                m_paint_begin = m_path.size() - steps;
            }
            if (i + 2U == points.size())
            {
                m_paint_end = m_path.size() - 1U;
            }
        }
        m_move =
            robotik::MoveTCPSkill({}, m_path.front(), m_settings.tolerance);
        m_stroke->color = m_color;
        m_ready = true;
    }
    // The first point approaches, the last one leaves: the brush paints in
    // between.
    m_stroke->painting = m_index >= m_paint_begin && m_index <= m_paint_end;
    robotik::Status const status =
        follow(m_path, m_index, m_move, p_context, p_dt);
    if (status != robotik::Status::RUNNING)
    {
        m_stroke->painting = false;
    }
    if (status == robotik::Status::SUCCESS)
    {
        m_stroke->painted.insert(m_color);
    }
    return status;
}

void MarkSkill::cancel(robotik::RobotContext& p_context)
{
    m_stroke->painting = false;
    m_move.cancel(p_context);
}

RinseSkill::RinseSkill(Stroke& p_stroke) : m_stroke(&p_stroke) {}

void RinseSkill::reset()
{
    m_path.clear();
    m_index = 0;
    m_ready = false;
    m_move.reset();
    m_stroke->painting = false;
}

robotik::Status RinseSkill::tick(robotik::RobotContext& p_context,
                                 robotik::Seconds p_dt)
{
    if (!m_ready)
    {
        robotik::WorldObject const* water = p_context.world_model.find("water");
        if (water == nullptr)
        {
            return robotik::Status::FAILURE;
        }
        robotik::Quaternion const down = brushDown();
        double const x = water->position.x;
        double const y = water->position.y;
        double const wet = top(*water) - 0.01;
        m_path.push_back({ { x, y, top(*water) + 0.18 }, down });
        constexpr int STEPS = 8;
        for (int turn = 0; turn < 2; ++turn)
        {
            for (int i = 0; i < STEPS; ++i)
            {
                double const angle =
                    (turn * STEPS + i) * (2.0 * std::numbers::pi / STEPS);
                m_path.push_back({ { x + 0.02 * std::cos(angle),
                                     y + 0.02 * std::sin(angle),
                                     wet },
                                   down });
            }
        }
        m_path.push_back({ { x, y, top(*water) + 0.18 }, down });
        m_move = robotik::MoveTCPSkill({}, m_path.front(), 2e-2);
        m_ready = true;
    }
    robotik::Status const status =
        follow(m_path, m_index, m_move, p_context, p_dt);
    if (status == robotik::Status::SUCCESS)
    {
        m_stroke->brush.clear();
    }
    return status;
}

void RinseSkill::cancel(robotik::RobotContext& p_context)
{
    m_move.cancel(p_context);
}

void registerNodes(bt::NodeFactory& p_factory,
                   robotik::SkillScheduler& p_scheduler)
{
    auto bind = [&](char const* p_node, char const* p_skill, Gesture p_gesture)
    {
        p_factory.registerNode(
            p_node,
            [&p_scheduler, name = std::string(p_skill), p_gesture]()
            {
                return std::make_unique<GestureNode>(
                    p_scheduler, p_scheduler.find(name), p_gesture);
            });
    };
    bind("Dip", "dip", Gesture::Dip);
    bind("Mark", "mark", Gesture::Mark);
    bind("Rinse", "rinse", Gesture::Rinse);
}

} // namespace painter
