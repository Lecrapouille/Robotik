# A small factory driven by a GRAFCET: the flowshop of TimedPetriNetEditor
# (data/examples/simple.flowshop) with two arms as the machines M1 and M2,
# three kinds of parts and two lots (worlds/factory_cell.world.yaml).
#
# scenarios/factory.grafcet.json is the event graph of the flowshop written as
# a GRAFCET (126 steps): one sequence of steps per operation (machine, part);
# AND convergences give the order of each machine and of each part (a part
# goes to M2 once machined by M1; the slot of a kind is free again once M2
# took the part). Machining is a time receptivity (2s/X12) while the arm
# holds the part. A Station step is a semaphore: one arm at a time between
# the machines, M2 first. factory.workflow.yaml gives the cycle time of the
# flowshop.
scenario:
  id: factory
  description: Two machines, three kinds of parts, two lots - the flowshop of simple.flowshop with robots.
  world: worlds/factory_cell.world.yaml
  seed: 42

  controller:
    grafcet:
      file: scenarios/factory.grafcet.json
      success: X125             # End: M2 dropped the last part

  perception: { fidelity: truth }   # the simulator gives the poses

  timeout: 240

  assertions:
    - controller.success
    - inside(p1a, output)
    - inside(p2a, output)
    - inside(p3a, output)
    - inside(p1b, output)
    - inside(p2b, output)
    - inside(p3b, output)
    - { condition: "collision_count(M1) == 0", phase: always }
    - { condition: "collision_count(M2) == 0", phase: always }
    # The machines work at the same time for a while.
    - dual_arm.overlap > 8
    - time < 70
# The factory as a flowshop: the processing times of simple.flowshop
# (TimedPetriNetEditor data/examples), machining only (the moves of the arms
# are not counted here). P1 P2 P3 visit M1 then M2.
#   ./build/Robotik-Headless build/plugins/DualArm/scenarios/factory.workflow.yaml
workflow:
  id: factory_line
  operators:
    - { id: M1, entity: M1 }
    - { id: M2, entity: M2 }
  products:
    - id: P1
      route:
        - { name: machining, on: M1, duration: 2.0 }
        - { name: machining, on: M2, duration: 1.0 }
    - id: P2
      route:
        - { name: machining, on: M1, duration: 3.0 }
        - { name: machining, on: M2, duration: 2.0 }
    - id: P3
      route:
        - { name: machining, on: M1, duration: 1.0 }
        - { name: machining, on: M2, duration: 1.5 }
# Path of the drill on the tray, in the frame of the tray: its centre,
# x and y along its sides, z up; z = 0.006 is the top face. The glasses
# stand at (+-0.09, +-0.10): the path draws a target between them. It
# starts on the side of the drill. A line along x through the corridor between the glasses (4.3 cm clear of them
# for the 3.2 cm radius of the drill body), back to the centre, a line
# along y through the other corridor (3.3 cm clear), then a circle of
# 4.5 cm radius in the free middle. The drill points down; the skill
# follows the tray while the other arm carries it.
trajectory:
  type: cartesian
  frame: tray
  orientation: { rpy: [3.141592653589793, 0.0, 0.0] }
  points:
    - [0.1100, 0.0000, 0.006]
    - [-0.1100, 0.0000, 0.006]
    - [0.0000, 0.0000, 0.006]
    - [0.0000, 0.1200, 0.006]
    - [0.0000, -0.1200, 0.006]
    - [0.0000, 0.0000, 0.006]
    - [0.0450, 0.0000, 0.006]
    - [0.0435, 0.0116, 0.006]
    - [0.0390, 0.0225, 0.006]
    - [0.0318, 0.0318, 0.006]
    - [0.0225, 0.0390, 0.006]
    - [0.0116, 0.0435, 0.006]
    - [0.0000, 0.0450, 0.006]
    - [-0.0116, 0.0435, 0.006]
    - [-0.0225, 0.0390, 0.006]
    - [-0.0318, 0.0318, 0.006]
    - [-0.0390, 0.0225, 0.006]
    - [-0.0435, 0.0116, 0.006]
    - [-0.0450, 0.0000, 0.006]
    - [-0.0435, -0.0116, 0.006]
    - [-0.0390, -0.0225, 0.006]
    - [-0.0318, -0.0318, 0.006]
    - [-0.0225, -0.0390, 0.006]
    - [-0.0116, -0.0435, 0.006]
    - [-0.0000, -0.0450, 0.006]
    - [0.0116, -0.0435, 0.006]
    - [0.0225, -0.0390, 0.006]
    - [0.0318, -0.0318, 0.006]
    - [0.0390, -0.0225, 0.006]
    - [0.0435, -0.0116, 0.006]
    - [0.0450, -0.0000, 0.006]
; One arm carries a tray of glasses, holding it from below; the other arm
; drills a path on the tray while it moves. A temporal domain: drill needs
; the tray in motion over all its duration, so the plan holds the tray
; during the drilling (required concurrency). The state is read on the
; shared beliefs by the observers of the mission (TrayMission.cpp).
; Durations are estimates in seconds: the executor waits for the skills,
; not for the clock.
(define (domain tray)
  (:requirements :strips :typing :durative-actions :negative-preconditions)

  (:types arm tray pad)

  (:predicates
    (free ?r - arm)                    ; the arm holds nothing
    (holding ?r - arm ?t - tray)       ; the cup of the arm holds the tray
    (rests ?t - tray ?p - pad)         ; the tray lies on the stand of the pad
    (above ?t - tray ?p - pad)         ; the held tray is over the pad
    (in_motion ?t - tray)              ; a plan token: true during a carry
    (drilled ?t - tray)                ; the drill followed its path on the tray
    (can_carry ?r - arm)               ; static: the arm has a cup
    (can_drill ?r - arm))              ; static: the arm has a drill

  ; Come under the tray, take it by its bottom face and raise it.
  (:durative-action lift
    :parameters (?r - arm ?t - tray ?p - pad)
    :duration (= ?duration 6)
    :condition (and (at start (free ?r)) (at start (can_carry ?r)) (at start (rests ?t ?p)))
    :effect (and (at start (not (free ?r)))
                 (at end (holding ?r ?t)) (at end (not (rests ?t ?p))) (at end (above ?t ?p))))

  ; Carry the raised tray over another stand.
  (:durative-action carry
    :parameters (?r - arm ?t - tray ?from - pad ?to - pad)
    :duration (= ?duration 22)
    :condition (and (at start (holding ?r ?t)) (at start (above ?t ?from)) (over all (holding ?r ?t)))
    :effect (and (at start (in_motion ?t))
                 (at end (not (in_motion ?t))) (at end (not (above ?t ?from))) (at end (above ?t ?to))))

  ; Touch the moving tray with the drill and follow the path on it.
  (:durative-action drill
    :parameters (?r - arm ?t - tray)
    :duration (= ?duration 19)
    :condition (and (at start (free ?r)) (at start (can_drill ?r)) (over all (in_motion ?t)))
    :effect (and (at start (not (free ?r))) (at end (free ?r)) (at end (drilled ?t))))

  ; Lower the tray on the stand under it and let it go.
  (:durative-action set_down
    :parameters (?r - arm ?t - tray ?p - pad)
    :duration (= ?duration 5)
    :condition (and (at start (holding ?r ?t)) (at start (above ?t ?p)))
    :effect (and (at end (rests ?t ?p)) (at end (free ?r)) (at end (not (holding ?r ?t)))
                 (at end (not (above ?t ?p))))))
# The left arm holds a tray of glasses from below and carries it from
# stand_a to stand_b; the right arm touches the tray with its drill and
# follows a path between the glasses while the tray moves. The drill feels
# the tray with its force sensor and keeps pressing with 5 N. A temporal PDDL
# domain: the planner puts the drilling during the carry, and the executor
# keeps the tray moving (and held) until the drilling ends. The tray and
# the glasses are rigid bodies: they would slide or fall for real.
scenario:
  id: tray
  description: Carry a tray of glasses from below with one arm while the other arm drills a path on it.
  world: worlds/tray_cell.world.yaml
  seed: 42

  controller:
    planner:
      domain: scenarios/tray.domain.pddl
      facts:
        - can_carry(left)
        - can_drill(right)
      goal:
        - drilled(tray)
        - rests(tray, pad_b)

  # The path of the drill, in the frame of the tray.
  trajectories:
    drill: scenarios/trajectories/drill_target.trajectory.yaml

  # Real bodies for the tray and the glasses: the cup of the left arm is at
  # the rigid level, so every box becomes a free body of MuJoCo.
  physics:
    fidelity: abstract
    overrides:
      left_gripper: rigid

  perception: { fidelity: truth }   # the simulator gives the poses

  timeout: 90

  assertions:
    - controller.success
    - planner.replans == 0
    - on(tray, stand_b)            # resting on the rails (a real contact)
    # No glass falls nor leaves the tray, at any time.
    - { condition: "on(g1, tray)", phase: always }
    - { condition: "on(g2, tray)", phase: always }
    - { condition: "on(g3, tray)", phase: always }
    - { condition: "on(g4, tray)", phase: always }
    # The drill touching the tray is its work (touches: [tray] in the
    # world); touching a glass, the stand or the other arm is a collision.
    - { condition: "collision_count(left) == 0", phase: always }
    - { condition: "collision_count(right) == 0", phase: always }
    # The drill pressed on the tray for most of its path (about 19 s long).
    - dual_arm.contact > 15
    # The drilling happens while the tray moves.
    - dual_arm.overlap > 4
