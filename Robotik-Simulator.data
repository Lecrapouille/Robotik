P := ../..
M := $(P)/.makefile

include $(P)/Makefile.common
TARGET_NAME := robotik_painter
TARGET_DESCRIPTION := Robotic painter demonstration
PLUGIN_NAME := Painter
PLUGIN_DIR := $(P)/plugins/Painter
PLUGIN_SRC := $(PLUGIN_DIR)/src
include $(M)/project/Makefile

LIB_FILES := $(PLUGIN_SRC)/Plugin.cpp $(PLUGIN_SRC)/PainterMission.cpp
LIB_FILES += $(PLUGIN_SRC)/PainterSkills.cpp

include $(P)/plugins/plugin.mk
<?xml version="1.0"?>
<!-- Chevalet de peintre (sans tableau). Repère de base : origine au sol au centre de l'empreinte,
     x = vers le peintre/robot (face du tableau), y = latéral, z = haut. Unités : SI. -->
<robot name="chevalet">
  <material name="bois"><color rgba="0.72 0.52 0.30 1"/></material>
  <material name="bois_fonce"><color rgba="0.55 0.38 0.20 1"/></material>

  <link name="easel_base">
    <inertial>
      <origin xyz="0.00000 0.00000 0.02500" rpy="0 0 0"/>
      <mass value="5.2650"/>
      <inertia ixx="0.360696" ixy="0.000000" ixz="0.000000" iyy="0.239484" iyz="0.000000" izz="0.597987"/>
    </inertial>
    <visual>
      <!-- patin_gauche -->
      <origin xyz="0.0000 0.3000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.9000 0.0600 0.0500"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- patin_gauche -->
      <origin xyz="0.0000 0.3000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.9000 0.0600 0.0500"/></geometry>
    </collision>
    <visual>
      <!-- patin_droit -->
      <origin xyz="0.0000 -0.3000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.9000 0.0600 0.0500"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- patin_droit -->
      <origin xyz="0.0000 -0.3000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.9000 0.0600 0.0500"/></geometry>
    </collision>
    <visual>
      <!-- traverse -->
      <origin xyz="0.0000 0.0000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.1000 0.5400 0.0500"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- traverse -->
      <origin xyz="0.0000 0.0000 0.0250" rpy="0 0 0"/>
      <geometry><box size="0.1000 0.5400 0.0500"/></geometry>
    </collision>
  </link>

  <link name="mast">
    <inertial>
      <origin xyz="0.00000 0.00000 0.80000" rpy="0 0 0"/>
      <mass value="4.1600"/>
      <inertia ixx="0.889685" ixy="0.000000" ixz="0.000000" iyy="0.888333" iyz="0.000000" izz="0.003085"/>
    </inertial>
    <visual>
      <!-- mat -->
      <origin xyz="0.0000 0.0000 0.8000" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0800 1.6000"/></geometry>
      <material name="bois"/>
    </visual>
    <collision>
      <!-- mat -->
      <origin xyz="0.0000 0.0000 0.8000" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0800 1.6000"/></geometry>
    </collision>
  </link>

  <link name="ledge">
    <inertial>
      <origin xyz="0.09121 0.00000 0.58782" rpy="0 0 0"/>
      <mass value="1.5129"/>
      <inertia ixx="0.032348" ixy="0.000000" ixz="0.000150" iyy="0.002664" iyz="0.000000" izz="0.034563"/>
    </inertial>
    <visual>
      <!-- tablette -->
      <origin xyz="0.0950 0.0000 0.5850" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.5000 0.0300"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- tablette -->
      <origin xyz="0.0950 0.0000 0.5850" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.5000 0.0300"/></geometry>
    </collision>
    <visual>
      <!-- rebord -->
      <origin xyz="0.0575 0.0000 0.6125" rpy="0 0 0"/>
      <geometry><box size="0.0150 0.5000 0.0250"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- rebord -->
      <origin xyz="0.0575 0.0000 0.6125" rpy="0 0 0"/>
      <geometry><box size="0.0150 0.5000 0.0250"/></geometry>
    </collision>
    <visual>
      <!-- butee_gauche -->
      <origin xyz="0.0500 0.2100 0.6200" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0100 0.0400"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- butee_gauche -->
      <origin xyz="0.0500 0.2100 0.6200" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0100 0.0400"/></geometry>
    </collision>
    <visual>
      <!-- butee_droite -->
      <origin xyz="0.0500 -0.2100 0.6200" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0100 0.0400"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- butee_droite -->
      <origin xyz="0.0500 -0.2100 0.6200" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0100 0.0400"/></geometry>
    </collision>
  </link>

  <link name="top_clamp">
    <inertial>
      <origin xyz="0.05036 0.00000 1.10214" rpy="0 0 0"/>
      <mass value="0.1092"/>
      <inertia ixx="0.000163" ixy="0.000000" ixz="0.000010" iyy="0.000046" iyz="0.000000" izz="0.000144"/>
    </inertial>
    <visual>
      <!-- plaque -->
      <origin xyz="0.0450 0.0000 1.1150" rpy="0 0 0"/>
      <geometry><box size="0.0400 0.1200 0.0200"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- plaque -->
      <origin xyz="0.0450 0.0000 1.1150" rpy="0 0 0"/>
      <geometry><box size="0.0400 0.1200 0.0200"/></geometry>
    </collision>
    <visual>
      <!-- retour -->
      <origin xyz="0.0575 0.0000 1.0850" rpy="0 0 0"/>
      <geometry><box size="0.0150 0.1200 0.0400"/></geometry>
      <material name="bois_fonce"/>
    </visual>
    <collision>
      <!-- retour -->
      <origin xyz="0.0575 0.0000 1.0850" rpy="0 0 0"/>
      <geometry><box size="0.0150 0.1200 0.0400"/></geometry>
    </collision>
  </link>

  <!-- ===== LINK D'ACCUEIL DU TABLEAU (repère sans masse) =====
       Origine : milieu de l'arête basse du dos du tableau, posée sur la tablette, dos contre le mât.
       Axes (inclinés de 10° avec le mât) : +x = normale de la face peinte (vers le robot),
       +y = largeur du tableau, +z = hauteur du tableau (dans son plan). -->
  <!-- Repère sans masse utile. Une inertie infinitésimale empêche le chargeur
       de lui substituer 1 kg (un lien sans <inertial> est sinon lesté). -->
  <link name="canvas_mount">
    <inertial>
      <mass value="1e-6"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="easel_base"/><child link="mast"/>
    <origin xyz="0 0 0.045" rpy="0 -0.174533 0"/>
  </joint>
  <joint name="ledge_joint" type="fixed">
    <parent link="mast"/><child link="ledge"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="top_clamp_joint" type="fixed">
    <parent link="mast"/><child link="top_clamp"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="canvas_mount_joint" type="fixed">
    <parent link="mast"/><child link="canvas_mount"/>
    <origin xyz="0.025 0 0.6" rpy="0 0 0"/>
  </joint>
</robot>
id: robotik.painter
version: 1.0.0
license: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
source: https://github.com/Lecrapouille/RobotIK
description: Easel of the painter demonstration (floating rigid body).
models:
  easel: chevalet.urdf
# The same portrait under several conditions. Whatever the friction or the
# canvas mass, painting must not move the easel.
experiment:
  id: painter_experiment
  description: Painting must not move the easel, whatever its grip on the floor.
  seeds: [7, 8]

  cases:
    - id: nominal
      scenario: scenarios/painter.scenario.yaml

    - id: slippery_floor
      scenario: scenarios/painter.scenario.yaml
      overrides:
        world.floor.friction: 0.1
        world.entities.easel.friction: 0.1

    - id: heavy_canvas
      scenario: scenarios/painter.scenario.yaml
      overrides:
        world.entities.canvas.mass: 2.0

  evaluation:
    metrics:
      - time
      - pose_error(easel)
      - pose_error(canvas)
      - collision_count(robot)
      - painter.stroke_deviation
      - painter.inked
plugin:
  id: robotik.painter
  name: Robotic painter
  version: 1.0.0
  api_version: 1
  category: Manipulation
  description: A robot arm paints colored strokes on an easel.

library:
  entrypoint: librobotik_painter.so

# Runtime assets. data/ is this plugin's own pack (the easel).
resources:
  directory: data
  packs:
    - { id: robotik.robots, version: "1.0" }
    - { id: robotik.tools, version: "1.0" }

scenarios:
  directory: scenarios
  entries:
    - { id: painter, name: Robotic painter, file: painter.scenario.yaml, menu: Behavior tree }
    - { id: painter_pddl, name: Robotic painter, file: painter_pddl.scenario.yaml, menu: PDDL planner }

experiments:
  directory: experiments
  entries:
    - { id: painter_experiment, name: Painting benchmark, file: painter.experiment.yaml }
# One subtree per colour. The parameter is the pot name and the stroke:
# Mark lays the line that belongs to that colour. Rinse stirs the brush
# in the water bucket before the next colour.

SubTrees:
  Layer:
    Sequence:
      name: Layer
      children:
        - Action:
            name: Dip
        - Action:
            name: Home
        - Action:
            name: Mark
        - Action:
            name: Home
        - Action:
            name: Rinse
        - Action:
            name: Home

BehaviorTree:
  Sequence:
    name: Portrait
    children:
      - Action:
          name: Home
      - SubTree:
          name: Red
          reference: Layer
          parameters:
            color: red
      - SubTree:
          name: Black
          reference: Layer
          parameters:
            color: black
      - SubTree:
          name: Blue
          reference: Layer
          parameters:
            color: blue
      - SubTree:
          name: Gold
          reference: Layer
          parameters:
            color: gold
      - Action:
          name: Home
; The painter: dip the brush in a pot, lay the stroke of that colour, rinse.
; The objects are the pots and the water bucket of the world (entities with
; a kind); the brush and the canvas are read from the memory of the robot
; (PainterMission.cpp). The order of the layers is a fact of the scenario.
(define (domain painter)
  (:requirements :adl)

  (:types pot bucket - object)

  (:predicates
    (clean)                       ; nothing on the brush
    (loaded ?c - pot)             ; the brush carries this colour
    (painted ?c - pot)            ; the stroke of this colour is on the canvas
    (before ?a - pot ?b - pot))   ; layer a goes under layer b (fact)

  (:action dip
    :parameters (?c - pot)
    :precondition (clean)
    :effect (and (loaded ?c) (not (clean))))

  ; A layer waits for the layers under it.
  (:action mark
    :parameters (?c - pot)
    :precondition (and (loaded ?c) (not (painted ?c))
                       (forall (?p - pot) (imply (before ?p ?c) (painted ?p))))
    :effect (painted ?c))

  (:action rinse
    :parameters (?c - pot ?w - bucket)
    :precondition (loaded ?c)
    :effect (and (clean) (not (loaded ?c)))))
scenario:
  id: painter
  description: |
    Dip the brush in each pot and lay a stroke on the canvas, rinsing it in
    between, without moving the easel.
  world: worlds/painting_lab.world.yaml
  seed: 7

  controller:
    behavior_tree: scenarios/painter.bt.yaml

  # One stroke per colour, read by the Mark gesture.
  trajectories:
    red: scenarios/trajectories/red_stroke.trajectory.yaml
    black: scenarios/trajectories/black_stroke.trajectory.yaml
    blue: scenarios/trajectories/blue_stroke.trajectory.yaml
    gold: scenarios/trajectories/gold_stroke.trajectory.yaml

  # The brush follows each stroke in 2 mm Cartesian steps (each one an IK
  # target), with stiff joints: the strokes are straight lines (deviation
  # about 1.5 mm). Joint gains alone do not do it: between two far targets
  # each joint moves on its own and the brush draws an arc (about 2 cm).
  parameters:
    stroke_step: 0.002      # m, longest step between two IK targets
    stroke_tolerance: 0.02  # rad, joint error to go on to the next target
    arm_gains: { kp: 1500, kd: 80 }   # N.m/rad, N.m.s/rad, every arm joint

  timeout: 120

  assertions:
    - { condition: "painter.stroke_deviation < 0.003", phase: end }   # straight strokes (m)
    - controller.success
    - { condition: "tool_is_attached(brush, robot.flange)", phase: always }
    - { condition: "joint_limits_respected(robot)", phase: always }
    - { condition: "collision_count(robot) == 0", phase: always }
    # Zero collision does not prove the easel stayed put: measure it.
    - { condition: "pose_error(easel) < 0.002", phase: always }
    - { condition: "pose_error(canvas) < 0.005", phase: always }
    - { condition: "on(canvas, easel)", phase: end }
    - name: brush loaded before the first stroke
      sequence:
        - skill_succeeded(dip)
        - skill_started(mark)
# The portrait of painter.scenario.yaml, with no behavior tree: the planner finds the
# dips, strokes and rinses from the goal, in the order of the layers.
scenario:
  id: painter_pddl
  description: |
    Plan the dips, strokes and rinses that paint the four layers, then do
    them, without moving the easel.
  world: worlds/painting_lab.world.yaml
  seed: 7

  controller:
    planner:
      domain: scenarios/painter.domain.pddl
      facts:
        - before(red, black)
        - before(black, blue)
        - before(blue, gold)
      goal:
        - painted(red)
        - painted(black)
        - painted(blue)
        - painted(gold)
        - clean

  # One stroke per colour, read by the Mark gesture.
  trajectories:
    red: scenarios/trajectories/red_stroke.trajectory.yaml
    black: scenarios/trajectories/black_stroke.trajectory.yaml
    blue: scenarios/trajectories/blue_stroke.trajectory.yaml
    gold: scenarios/trajectories/gold_stroke.trajectory.yaml

  # The brush follows each stroke in 2 mm Cartesian steps (each one an IK
  # target), with stiff joints: the strokes are straight lines (deviation
  # about 1.5 mm). Joint gains alone do not do it: between two far targets
  # each joint moves on its own and the brush draws an arc (about 2 cm).
  parameters:
    stroke_step: 0.002      # m, longest step between two IK targets
    stroke_tolerance: 0.02  # rad, joint error to go on to the next target
    arm_gains: { kp: 1500, kd: 80 }   # N.m/rad, N.m.s/rad, every arm joint

  timeout: 160

  assertions:
    - { condition: "painter.stroke_deviation < 0.003", phase: end }   # straight strokes (m)
    - controller.success
    - planner.replans == 0
    - { condition: "tool_is_attached(brush, robot.flange)", phase: always }
    - { condition: "joint_limits_respected(robot)", phase: always }
    - { condition: "collision_count(robot) == 0", phase: always }
    - { condition: "pose_error(easel) < 0.002", phase: always }
    - { condition: "pose_error(canvas) < 0.005", phase: always }
    - { condition: "on(canvas, easel)", phase: end }
    - name: brush loaded before the first stroke
      sequence:
        - skill_succeeded(dip)
        - skill_started(mark)
# Stroke of the black layer, in the canvas mount frame of the easel: +x
# toward the robot, +z up the canvas. The brush stays 4 cm off the board so
# it does not push the free canvas. First and last points approach and
# leave; the brush paints between them.
trajectory:
  type: cartesian
  frame: easel.canvas_mount
  # Brush pointing into the canvas (-x of the mount), its +y up the canvas.
  orientation: { rpy: [1.5707963267948966, 0.0, -1.5707963267948966] }
  points:
    - [0.30, 0.04, 0.16]
    - [0.08, 0.00, 0.16]
    - [0.06, 0.00, 0.16]
    - [0.06, 0.08, 0.16]
    - [0.30, 0.04, 0.16]
# Stroke of the blue layer, in the canvas mount frame of the easel: +x
# toward the robot, +z up the canvas. The brush stays 4 cm off the board so
# it does not push the free canvas. First and last points approach and
# leave; the brush paints between them.
trajectory:
  type: cartesian
  frame: easel.canvas_mount
  # Brush pointing into the canvas (-x of the mount), its +y up the canvas.
  orientation: { rpy: [1.5707963267948966, 0.0, -1.5707963267948966] }
  points:
    - [0.30, -0.04, 0.16]
    - [0.08, -0.08, 0.16]
    - [0.06, -0.08, 0.16]
    - [0.06, 0.00, 0.16]
    - [0.30, -0.04, 0.16]
# Stroke of the gold layer, in the canvas mount frame of the easel: +x
# toward the robot, +z up the canvas. The brush stays 4 cm off the board so
# it does not push the free canvas. First and last points approach and
# leave; the brush paints between them.
trajectory:
  type: cartesian
  frame: easel.canvas_mount
  # Brush pointing into the canvas (-x of the mount), its +y up the canvas.
  orientation: { rpy: [1.5707963267948966, 0.0, -1.5707963267948966] }
  points:
    - [0.30, -0.12, 0.16]
    - [0.08, -0.16, 0.16]
    - [0.06, -0.16, 0.16]
    - [0.06, -0.08, 0.16]
    - [0.30, -0.12, 0.16]
# Stroke of the red layer, in the canvas mount frame of the easel: +x
# toward the robot, +z up the canvas. The brush stays 4 cm off the board so
# it does not push the free canvas. First and last points approach and
# leave, 30 cm off the board: the way to and from Home then passes in front
# of the ledge, not over it. The brush paints between them.
trajectory:
  type: cartesian
  frame: easel.canvas_mount
  # Brush pointing into the canvas (-x of the mount), its +y up the canvas.
  orientation: { rpy: [1.5707963267948966, 0.0, -1.5707963267948966] }
  points:
    - [0.30, 0.12, 0.16]
    - [0.08, 0.08, 0.16]
    - [0.06, 0.08, 0.16]
    - [0.06, 0.16, 0.16]
    - [0.30, 0.12, 0.16]
