#pragma once

#include "Robotik/Task/Mission.hpp"
#include "Robotik/Task/Skills/Skill.hpp"

// ****************************************************************************
/// Lesson 4: a skill. It swings the base joint left, right, left,
/// right, then succeeds.
///
/// A skill only sees the @ref robotik::RobotContext: the robot API and its
/// beliefs. It cannot tell a simulation from a real robot.
// ****************************************************************************
class WaveSkill final: public robotik::Skill
{
public:

    void reset() override;
    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

private:

    int m_waves = 0;
};

// ****************************************************************************
/// Lesson 4: registers the skill "Wave". The behavior tree of the
/// scenario calls it by that name.
// ****************************************************************************
class SkillsMission final: public robotik::Mission
{
public:

    void setup(robotik::Cell& p_cell,
               robotik::SceneView* p_view) override;
};
# A bare 6-axis arm on the floor. Nothing else.
world:
  id: arm
  entities:
    - id: robot
      type: robot
      # Asset id: <pack>.<model>, found in data/packs by the asset resolver.
      model: robotik.robots.robot_6axis
      # Joint angles (rad) the robot holds at start and goes back to on Home.
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      actuators:
        # One actuator commanding every joint. It is also the resource "arm".
        arm: { type: joint_group }
