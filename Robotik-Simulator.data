#include "ReachMission.hpp"

#include "Robotik/Task/Cell.hpp"

#include <cmath>
#include <optional>

/// Distance between two poses.
static double distance(robotik::Pose const& p_from, robotik::Pose const& p_to)
{
    double const dx = p_from.position.x - p_to.position.x;
    double const dy = p_from.position.y - p_to.position.y;
    double const dz = p_from.position.z - p_to.position.z;
    return std::sqrt(dx * dx + dy * dy + dz * dz);
}

void ReachMission::reset(robotik::Cell& p_cell,
                         robotik::Seed /*p_seed*/)
{
    robotik::Robot& robot = p_cell.robot();

    // The tool frame is "tcp" when a tool is mounted, "tool0" otherwise.
    robotik::Pose const start = robot.framePose(robot.tool());
    m_target = start;
    m_target.position.x += 0.03;

    // Inverse kinematics: no answer when the pose is out of reach.
    std::optional<std::vector<double>> const solution =
        robot.inverseKinematics(robot.tool(), m_target);
    m_solution = solution ? *solution : std::vector<double>{};
    m_error = distance(start, m_target);
}

void ReachMission::step(robotik::Cell& p_cell, robotik::Seconds /*p_dt*/)
{
    robotik::Robot& robot = p_cell.robot();
    robotik::JointSet& joints = robot.joints();
    for (robotik::JointId id = 0; id < joints.size() && id < m_solution.size();
         ++id)
    {
        joints.moveTo(id, m_solution[id]);
    }
    m_error = distance(robot.framePose(robot.tool()), m_target);
}

void ReachMission::measure(robotik::Cell const& /*p_cell*/,
                           robotik::Metrics& p_metrics) const
{
    p_metrics.set("reach.error", m_error);
}

robotik::Status
ReachMission::status(robotik::Cell const& /*p_cell*/) const
{
    if (m_solution.empty())
    {
        return robotik::Status::FAILURE;
    }
    return m_error < 0.005 ? robotik::Status::SUCCESS
                           : robotik::Status::RUNNING;
}
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#pragma once

#include "Robotik/Common/Math.hpp"
#include "Robotik/Task/Mission.hpp"

#include <vector>

// ****************************************************************************
/// Lesson 3: ask for a tool position, let inverse kinematics find the
/// joint angles.
///
/// At reset, the target is the current tool pose moved three centimetres
/// along x. Inverse kinematics gives one angle per joint; each step commands
/// them and publishes the remaining distance as "reach.error".
// ****************************************************************************
class ReachMission final: public robotik::Mission
{
public:

    void reset(robotik::Cell& p_cell,
               robotik::Seed p_seed) override;
    void step(robotik::Cell& p_cell, robotik::Seconds p_dt) override;
    void measure(robotik::Cell const& p_cell,
                 robotik::Metrics& p_metrics) const override;
    [[nodiscard]] robotik::Status
    status(robotik::Cell const& p_cell) const override;

    [[nodiscard]] double error() const
    {
        return m_error;
    }

private:

    robotik::Pose m_target{};
    std::vector<double> m_solution;
    double m_error = 1.0;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "WaveMission.hpp"

#include "Robotik/Task/Cell.hpp"

#include <algorithm>
#include <cmath>

void WaveMission::reset(robotik::Cell& /*p_cell*/,
                        robotik::Seed /*p_seed*/)
{
    m_swing = 0.0;
    m_tool_y = 0.0;
}

void WaveMission::step(robotik::Cell& p_cell, robotik::Seconds /*p_dt*/)
{
    robotik::Robot& robot = p_cell.robot();
    robotik::JointSet& joints = robot.joints();

    // A typed handle: the angle is in radians, the compiler checks it.
    robotik::Revolute const base = joints.revolute("joint1");
    if (!base)
    {
        return;
    }

    // Command: a target angle. The joint controller moves toward it.
    robotik::Radians const home = joints.home(base);
    robotik::Radians const offset(0.6 * std::sin(p_cell.time().value()));
    joints.moveTo(base, home + offset);

    // Measure: the angle reached, and where the tool is (forward kinematics,
    // in the robot base frame).
    m_swing =
        std::max(m_swing, std::abs((joints.position(base) - home).value()));
    m_tool_y = robot.framePose(robot.tool()).position.y;
}

void WaveMission::measure(robotik::Cell const& /*p_cell*/,
                          robotik::Metrics& p_metrics) const
{
    p_metrics.set("wave.swing", m_swing);
    p_metrics.set("wave.tool_y", m_tool_y);
}

robotik::Status
WaveMission::status(robotik::Cell const& p_cell) const
{
    if (p_cell.time() >= robotik::Seconds(6.0))
    {
        return robotik::Status::SUCCESS;
    }
    return robotik::Status::RUNNING;
}
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#pragma once

#include "Robotik/Task/Mission.hpp"

// ****************************************************************************
/// Lesson 2: command a joint, read the tool pose.
///
/// The base joint follows a sine around its home angle. Each step reads the
/// pose of the tool frame (forward kinematics) and publishes how far the
/// joint swung. The mission succeeds after six seconds.
// ****************************************************************************
class WaveMission final: public robotik::Mission
{
public:

    void reset(robotik::Cell& p_cell,
               robotik::Seed p_seed) override;
    void step(robotik::Cell& p_cell, robotik::Seconds p_dt) override;
    void measure(robotik::Cell const& p_cell,
                 robotik::Metrics& p_metrics) const override;
    [[nodiscard]] robotik::Status
    status(robotik::Cell const& p_cell) const override;

private:

    double m_swing = 0.0;
    double m_tool_y = 0.0;
};
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
// Copyright (c) 2020-2026 Quentin Quadrat
//
// This file is part of RobotIK. It is available under the GNU GPL v3 or,
// for users who cannot use the GPL, under a commercial license.
// See LICENSING.md for details.

#include "WaveSkill.hpp"

#include "Robotik/Robot/Robot.hpp"
#include "Robotik/Task/RobotContext.hpp"
#include "Robotik/Task/Cell.hpp"

void WaveSkill::reset()
{
    m_waves = 0;
}

robotik::Status WaveSkill::tick(robotik::RobotContext& p_context,
                                robotik::Seconds /*p_dt*/)
{
    robotik::JointSet& joints = p_context.robot.joints();
    robotik::JointId const base = joints.find("joint1");
    if (base == robotik::NO_JOINT)
    {
        return robotik::Status::FAILURE;
    }

    double const target = (m_waves % 2 == 0) ? 0.5 : -0.5;
    joints.moveTo(base, target);
    if (joints.reached(base, 0.02))
    {
        ++m_waves;
    }
    return m_waves >= 4 ? robotik::Status::SUCCESS : robotik::Status::RUNNING;
}

void WaveSkill::cancel(robotik::RobotContext& p_context)
{
    // Cancelled or preempted: stop where we are.
    p_context.robot.joints().hold();
}

void SkillsMission::setup(robotik::Cell& p_cell,
                          robotik::SceneView* /*p_view*/)
{
    // The skill reserves the actuator "arm" while it runs: no other skill
    // can move the arm at the same time.
    robotik::SkillDescription wave;
    wave.name = "Wave";
    wave.resources = { p_cell.robot().resources().require("arm") };
    wave.priority = 100;
    p_cell.skills().add<WaveSkill>(std::move(wave));
}
// SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
