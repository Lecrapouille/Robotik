# See LICENSING.md for details.

P := ../..
M := $(P)/.makefile

include $(P)/Makefile.common
TARGET_NAME := robotik_hello_world
TARGET_DESCRIPTION := Tutorial plugin: one small lesson per scenario
PLUGIN_NAME := HelloWorld
PLUGIN_DIR := $(P)/plugins/HelloWorld
PLUGIN_SRC := $(PLUGIN_DIR)/src
include $(M)/project/Makefile

LIB_FILES := $(PLUGIN_SRC)/Plugin.cpp $(PLUGIN_SRC)/HelloMission.cpp
LIB_FILES += $(PLUGIN_SRC)/WaveMission.cpp $(PLUGIN_SRC)/ReachMission.cpp
LIB_FILES += $(PLUGIN_SRC)/WaveSkill.cpp

include $(P)/plugins/plugin.mk
# Runs the lessons as variants and compares them. Each case rebuilds its world.
experiment:
  id: hello_experiment
  seeds: [1, 2]

  cases:
    - id: wave
      scenario: scenarios/wave.scenario.yaml

    - id: skills
      scenario: scenarios/skills.scenario.yaml

    # Same scenario, the arm in fault for one second, and another strategy:
    # a behavior tree that retries Wave. The assertions do not change.
    - id: skills_arm_fault
      scenario: scenarios/skills.scenario.yaml
      controller: { behavior_tree: scenarios/skills_retry.bt.yaml }
      setup:
        - inject_fault: { resource: arm, at: 1.0, action: disable }
        - inject_fault: { resource: arm, at: 2.0, action: restore }

  evaluation:
    # Added to the assertions of every scenario.
    assertions:
      - { condition: "joint_limits_respected(robot)", phase: always }
    # Read at the end of each run, written in the report.
    metrics: [ time ]
# Tutorial package. Each scenario is one lesson, see doc/04-Your-First-Plugin.md.
plugin:
  id: robotik.hello_world
  name: Hello world
  version: 1.0.0
  api_version: 1
  category: Tutorial
  description: Tutorial. A 6-axis arm waves, reaches a point and runs skills from a behavior tree.

library:
  entrypoint: librobotik_hello_world.so

resources:
  packs:
    - { id: robotik.robots, version: "1.0" }

scenarios:
  directory: scenarios
  entries:
    - { id: hello, name: 1. Hello, file: hello.scenario.yaml }
    - { id: wave, name: 2. Move a joint, file: wave.scenario.yaml }
    - { id: reach, name: 3. Reach a point, file: reach.scenario.yaml }
    - { id: skills, name: 4. Skill and behavior tree, file: skills.scenario.yaml }

experiments:
  directory: experiments
  entries:
    - { id: hello_experiment, name: Hello experiment, file: hello.experiment.yaml }
# Lesson 1: the smallest mission. It counts simulation steps and stops
# after two seconds.
scenario:
  id: hello
  description: Count the simulation steps, then stop after two seconds.
  world: worlds/arm.world.yaml
  seed: 1
  timeout: 30
  assertions:
    - controller.success
    - hello.ticks > 100
    - time < 3
# Lesson 3: ask for a tool position, let inverse kinematics find the joints.
# The assertion is red at the start and turns green: it does not stop the run.
scenario:
  id: reach
  description: Move the tool three centimetres forward with inverse kinematics.
  world: worlds/arm.world.yaml
  seed: 1
  timeout: 30
  assertions:
    - controller.success
    - { condition: "reach.error < 0.02", within: 5.0 }
# Each Action is a skill of the scheduler, called by its name.
# Home and Stop come with every simulation; Wave comes from the plugin.
BehaviorTree:
  Sequence:
    name: HelloSkills
    children:
      - Action:
          name: Home
      - Action:
          name: Wave
      - Action:
          name: Home
# Lesson 4: a skill of the plugin, run by a behavior tree.
scenario:
  id: skills
  description: Go home, wave twice, go home again.
  world: worlds/arm.world.yaml
  seed: 1
  controller:
    behavior_tree: scenarios/skills.bt.yaml
  timeout: 30
  assertions:
    - controller.success
    - skill_succeeded(Wave)
    - { condition: "joint_limits_respected(robot)", phase: always }
    - name: home before waving
      sequence: [ "skill_succeeded(Home)", "skill_started(Wave)" ]
# Same as skills.bt.yaml, but Wave is tried again until it succeeds: a fault
# on the arm makes it fail at once, the retry waits for the arm to come back.
BehaviorTree:
  Sequence:
    name: HelloSkillsRetry
    children:
      - Action:
          name: Home
      - UntilSuccess:
          attempts: 1000
          child:
            - Action:
                name: Wave
      - Action:
          name: Home
# Lesson 2: command a joint and read where the tool goes (forward kinematics).
scenario:
  id: wave
  description: Swing the base joint left and right for six seconds.
  world: worlds/arm.world.yaml
  seed: 1
  timeout: 30
  assertions:
    - controller.success
    - wave.swing > 0.4
    - { condition: "joint_limits_respected(robot)", phase: always }
