#include "PickPlaceMission.hpp"

#include "ColorDetector.hpp"

#include "PickPlacePlanning.hpp"
#include "PickPlaceSkills.hpp"
#include "Robotik/Robot/Components/Objects.hpp"
#include "Robotik/Task/Cell.hpp"

static constexpr double APPROACH_CLEARANCE = 0.10;
static constexpr double TRANSIT_CLEARANCE = 0.22;
static constexpr int SKILL_PRIORITY = 100;

void PickPlaceMission::setup(robotik::Cell& p_cell,
                             robotik::SceneView* /*p_view*/)
{
    if (!m_skills)
    {
        return;
    }

    // Perception: map each prop colour to a Detect(label) target.
    std::vector<robotik::EntitySpec const*> props;
    for (robotik::EntitySpec const& entity :
         p_cell.description().world.entities)
    {
        if (entity.type == robotik::EntitySpec::Type::Prop)
        {
            props.push_back(&entity);
        }
    }
    for (robotik::EntitySpec const* prop : props)
    {
        if (m_detector == nullptr)
        {
            m_detector = &p_cell.perception().add<ColorDetector>();
        }
        m_detector->add(prop->id, prop->shape->color);
    }

    robotik::ResourceManager const& resources =
        p_cell.robot().resources();
    robotik::ActuatorSet const& actuators = p_cell.robot().actuators();
    robotik::SkillScheduler& skills = p_cell.skills();

    std::vector<robotik::ResourceRequirement> arm;
    if (auto const* group = actuators.first<robotik::JointGroup>())
    {
        arm.push_back(resources.require(group->name()));
    }
    std::vector<robotik::ResourceRequirement> gripper;
    if (auto const* vacuum = actuators.first<robotik::VacuumGripper>())
    {
        gripper.push_back(resources.require(vacuum->name()));
    }
    std::vector<robotik::ResourceRequirement> camera;
    if (robotik::Camera const* found = p_cell.camera())
    {
        camera.push_back(
            resources.require(found->name(), robotik::Access::Shared));
    }

    auto describe = [](std::string p_name,
                       std::vector<robotik::ResourceRequirement> p_resources)
    {
        robotik::SkillDescription description;
        description.name = std::move(p_name);
        description.resources = std::move(p_resources);
        description.priority = SKILL_PRIORITY;
        return description;
    };

    skills.add<robotik::ReleaseSkill>(describe("Release", gripper));

    // One skill family per prop; containers also get Transit (carry height).
    for (robotik::EntitySpec const* prop : props)
    {
        std::string const& name = prop->id;
        skills.add<robotik::DetectSkill>(
            describe("Detect(" + name + ")", camera), name);
        skills.add<robotik::ApproachSkill>(
            describe("Approach(" + name + ")", arm),
            name,
            robotik::Length(APPROACH_CLEARANCE));
        skills.add<robotik::ApproachSkill>(
            describe("Reach(" + name + ")", arm), name, robotik::Length{});

        robotik::SkillDescription grasp =
            describe("Grasp(" + name + ")", gripper);
        grasp.wait = false;
        grasp.preconditions.push_back(
            { "gripper is empty",
              [](robotik::RobotContext const& p_context)
              {
                  robotik::VacuumGripper const* vacuum =
                      robotik::findGripper(p_context.robot, std::string{});
                  return vacuum != nullptr && !vacuum->holding();
              } });
        skills.add<robotik::GraspSkill>(std::move(grasp), name);
        if (prop->shape->type == robotik::ShapeSpec::Type::Container)
        {
            skills.add<robotik::ApproachSkill>(
                describe("Transit(" + name + ")", arm),
                name,
                robotik::Length(TRANSIT_CLEARANCE));
        }
    }

    if (m_planner)
    {
        registerPlanning(p_cell.planning());
    }
}
