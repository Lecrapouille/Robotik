/// @file TraySkills.hpp
/// Skills of the tray scenario: a smooth straight move of the tool
/// (glasses on a tray do not like jerks), and a path drilled on the tray
/// that follows the arm carrying it.
#pragma once

#include "Robotik/Common/Math.hpp"
#include "Robotik/Task/Skills/Skill.hpp"

#include <optional>
#include <string>
#include <vector>

namespace dual_arm
{

// ****************************************************************************
/// Moves the tool in a straight line, orientation kept, with a
/// minimum-jerk profile over a fixed time: by an offset, under or above an
/// object of the beliefs at the same height, or under its bottom face. The
/// speed limits of the joints may make it slower, never faster.
// ****************************************************************************
class PathSkill final: public robotik::Skill
{
public:

    /// By @p_offset (m, in the robot base frame).
    PathSkill(robotik::Vector3 const& p_offset, robotik::Seconds p_duration);

    /// Above the believed centre of @p_object, at the same height.
    PathSkill(std::string p_object, robotik::Seconds p_duration);

    /// @p_below under the believed bottom face of @p_object.
    PathSkill(std::string p_object, robotik::Length p_below, robotik::Seconds p_duration);

    void reset() override
    {
        m_started = false;
        m_why.clear();
    }

    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

    [[nodiscard]] std::string why() const override
    {
        return m_why;
    }

private:

    robotik::Vector3 m_offset = robotik::Vector3::ZERO;
    std::string m_object;
    /// Under the bottom face of the object by this much, if set.
    std::optional<double> m_below;
    robotik::Seconds m_duration;
    bool m_started = false;
    robotik::Seconds m_elapsed{};
    robotik::Pose m_from{ robotik::Vector3::ZERO, robotik::Quaternion{} };
    robotik::Vector3 m_to = robotik::Vector3::ZERO;
    std::string m_why;
};

// ****************************************************************************
/// Touches a tray that another arm carries with the tool, presses on
/// it with @p_force and follows @p_path on its top at @p_speed, then lifts.
///
/// The contact is felt, not assumed: the tool goes down until the force
/// sensor of the robot feels the tray, then it moves up or down to keep the
/// force (an admittance). The believed tray gives only the path in x and y.
///
/// The two arms are synchronized: the path is drawn in the frame of the
/// tool of the carrying arm, followed through what that arm measures of
/// itself (@ref robotik::RobotContext::team), not through the camera. The
/// spindle of a drill stays still: a turning bit would drag the tray (and
/// its glasses) by friction.
// ****************************************************************************
class TraceSkill final: public robotik::Skill
{
public:

    /// @param p_path Points in the frame of the tray: its centre, axes of
    /// the world (the carrier keeps it level and does not turn it).
    TraceSkill(std::string p_tray,
               std::vector<robotik::Vector3> p_path,
               robotik::LinearVelocity p_speed,
               robotik::Force p_force,
               robotik::Seconds p_timeout = robotik::Seconds(40.0));

    void reset() override
    {
        m_phase = Phase::Approach;
        m_offsets.clear();
        m_height = 0.0;
        m_travel = 0.0;
        m_tare = robotik::Vector3::ZERO;
        m_elapsed = robotik::Seconds{};
        m_why.clear();
    }

    robotik::Status tick(robotik::RobotContext& p_context,
                         robotik::Seconds p_dt) override;
    void cancel(robotik::RobotContext& p_context) override;

    [[nodiscard]] std::string why() const override
    {
        return m_why;
    }

private:

    /// From above the first point, down onto the tray, along the path, up.
    enum class Phase
    {
        Approach,
        Descend,
        Follow,
        Lift,
    };

    /// Point of the path at @p_travel metres from its start, in the
    /// tool frame of the carrier.
    [[nodiscard]] robotik::Vector3 along(double p_travel) const;

    std::string m_tray;
    std::vector<robotik::Vector3> m_path;
    robotik::LinearVelocity m_speed;
    robotik::Force m_force;
    robotik::Seconds m_timeout;
    Phase m_phase = Phase::Approach;
    /// Points of the path in the tool frame of the carrying arm.
    std::vector<robotik::Vector3> m_offsets;
    /// Height of the tool over the path (m), negative when it presses.
    double m_height = 0.0;
    /// Force read before the contact (the weight of the tool), subtracted.
    robotik::Vector3 m_tare = robotik::Vector3::ZERO;
    /// Length of the path done (m).
    double m_travel = 0.0;
    robotik::Seconds m_elapsed{};
    std::string m_why;
};

} // namespace dual_arm
# Two 6-axis arms side by side, each with a vacuum cup and a wrist camera.
# A conveyor of two lanes runs between them. The parts wait on its infeed
# table, far in front of both arms; the belt pushes one onto a lane and
# carries it to the end stop, on the pick zone of that lane. Each arm drops
# its parts in its own bin. Z-up, metres, radians. Seen from above:
#
#     bin_left (0.05, -0.75)                          bin_right (0.05, 0.75)
#   left (0, -0.35)                                          right (0, 0.35)
#        end stop (0.30)  zone_left (0.40, -0.13)  ... lane ...  infeed (1.37): p1 p2 p3 p4
#                         zone_right (0.40, 0.13)  ... lane ...
world:
  id: conveyor_cell

  entities:
    - id: left
      type: robot
      kind: arm                 # an object of the PDDL planner too
      model: robotik.robots.robot_6axis
      pose: { position: [0.0, -0.35, 0.0] }
      # The tool points down.
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      sensors:
        left_camera:
          type: camera
          parent: link6
          position: [0.05, 0.0, 0.0]
          fov: 70
          resolution: [320, 240]
          frequency: 15
      actuators:
        left_arm: { type: joint_group }
    - id: left_cup
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: left.flange, frame: tool_mount }
      actuators:
        left_gripper: { type: vacuum }

    - id: right
      type: robot
      kind: arm
      model: robotik.robots.robot_6axis
      pose: { position: [0.0, 0.35, 0.0] }
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      sensors:
        right_camera:
          type: camera
          parent: link6
          position: [0.05, 0.0, 0.0]
          fov: 70
          resolution: [320, 240]
          frequency: 15
      actuators:
        right_arm: { type: joint_group }
    - id: right_cup
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: right.flange, frame: tool_mount }
      actuators:
        right_gripper: { type: vacuum }

    # The conveyor: a fixed body, its belt top 0.10 m high. The belt runs
    # from x = 0.30 (end stop) to x = 1.30, then the infeed table to 1.44.
    - id: conveyor
      type: body
      model: robotik.dual_arm.conveyor
      physics: fixed
      pose: { position: [0.30, 0.0, 0.0] }

    # Places on the belt: flat frames, their floor 1 mm above the belt (not
    # at the same height: the two surfaces would flicker).
    - id: feeder
      type: prop
      kind: feeder
      shape: { type: container, size: [0.10, 0.48, 0.01] }
      color: [0.25, 0.25, 0.25]
      pose: { position: [1.37, 0.0, 0.101] }
    - id: zone_left
      type: prop
      kind: zone
      shape: { type: container, size: [0.12, 0.12, 0.01] }
      color: [0.95, 0.75, 0.10]
      pose: { position: [0.40, -0.13, 0.101] }
    - id: zone_right
      type: prop
      kind: zone
      shape: { type: container, size: [0.12, 0.12, 0.01] }
      color: [0.95, 0.75, 0.10]
      pose: { position: [0.40, 0.13, 0.101] }

    # Parts waiting on the infeed table, out of reach of both arms, red and
    # blue mixed: the belt sends each one to the lane of its arm.
    - id: p1
      type: prop
      kind: part
      shape: { type: box, size: [0.04, 0.04, 0.04] }
      color: [0.9, 0.1, 0.1]
      pose: { position: [1.37, -0.18, 0.12] }
    - id: p2
      type: prop
      kind: part
      shape: { type: box, size: [0.04, 0.04, 0.04] }
      color: [0.1, 0.3, 0.9]
      pose: { position: [1.37, -0.06, 0.12] }
    - id: p3
      type: prop
      kind: part
      shape: { type: box, size: [0.04, 0.04, 0.04] }
      color: [0.9, 0.1, 0.1]
      pose: { position: [1.37, 0.06, 0.12] }
    - id: p4
      type: prop
      kind: part
      shape: { type: box, size: [0.04, 0.04, 0.04] }
      color: [0.1, 0.3, 0.9]
      pose: { position: [1.37, 0.18, 0.12] }

    - id: bin_left
      type: prop
      kind: bin
      shape: { type: container, size: [0.16, 0.16, 0.08] }
      color: [0.9, 0.5, 0.5]
      pose: { position: [0.05, -0.75, 0.04] }
    - id: bin_right
      type: prop
      kind: bin
      shape: { type: container, size: [0.16, 0.16, 0.08] }
      color: [0.5, 0.6, 0.95]
      pose: { position: [0.05, 0.75, 0.04] }
# A small factory: the flowshop of TimedPetriNetEditor
# (data/examples/simple.flowshop) with robots. Two arms are the machines M1
# and M2; three kinds of parts P1 (red), P2 (green), P3 (blue) come in two
# lots. M1 takes a part from its stock, machines it while holding it, and
# puts it on the station of its kind (slot1..3, between the arms); M2 takes
# it there, carries it over the output bin, machines it, and drops it.
# Machining times (s), as in simple.flowshop:  P1  P2  P3
#                                          M1   2   3   1
#                                          M2   1   2   1.5
world:
  id: factory_cell

  entities:
    - id: M1
      type: robot
      kind: arm
      model: robotik.robots.robot_6axis
      pose: { position: [0.0, -0.25, 0.0] }
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      actuators:
        M1_arm: { type: joint_group }
    - id: M1_cup
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: M1.flange, frame: tool_mount }
      actuators:
        M1_gripper: { type: vacuum }

    - id: M2
      type: robot
      kind: arm
      model: robotik.robots.robot_6axis
      pose: { position: [0.0, 0.25, 0.0] }
      home: { joint1: 0.0, joint2: 0.3, joint3: 1.3, joint4: 0.0, joint5: 1.54, joint6: 0.0 }
      actuators:
        M2_arm: { type: joint_group }
    - id: M2_cup
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: M2.flange, frame: tool_mount }
      actuators:
        M2_gripper: { type: vacuum }

    # Stock of M1: lot a in front, lot b behind.
    - { id: p1a, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.9, 0.1, 0.1], pose: { position: [0.15, -0.50, 0.02] } }
    - { id: p2a, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.1, 0.75, 0.2], pose: { position: [0.25, -0.50, 0.02] } }
    - { id: p3a, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.1, 0.3, 0.9], pose: { position: [0.35, -0.50, 0.02] } }
    - { id: p1b, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.9, 0.1, 0.1], pose: { position: [0.15, -0.60, 0.02] } }
    - { id: p2b, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.1, 0.75, 0.2], pose: { position: [0.25, -0.60, 0.02] } }
    - { id: p3b, type: prop, kind: part, shape: { type: box, size: [0.04, 0.04, 0.04] }, color: [0.1, 0.3, 0.9], pose: { position: [0.35, -0.60, 0.02] } }

    # Stations between the two machines, one per kind of part.
    - { id: slot1, type: prop, kind: bin, shape: { type: container, size: [0.10, 0.10, 0.01] }, color: [0.9, 0.6, 0.6], pose: { position: [0.25, 0.0, 0.005] } }
    - { id: slot2, type: prop, kind: bin, shape: { type: container, size: [0.10, 0.10, 0.01] }, color: [0.6, 0.9, 0.6], pose: { position: [0.36, 0.0, 0.005] } }
    - { id: slot3, type: prop, kind: bin, shape: { type: container, size: [0.10, 0.10, 0.01] }, color: [0.6, 0.6, 0.9], pose: { position: [0.47, 0.0, 0.005] } }

    # Output of M2.
    - { id: output, type: prop, kind: bin, shape: { type: container, size: [0.20, 0.20, 0.08] }, color: [0.8, 0.8, 0.8], pose: { position: [0.18, 0.55, 0.04] } }
# Two 6-axis arms face to face. The left one holds a tray with a vacuum cup
# from below, its cup pointing up between the rails of a stand, and carries
# it from one stand to the other. The right one stands on a pedestal; its
# drill touches the tray between the glasses and follows a path while the
# tray moves. The arms never meet: one works under the tray, the other one
# above it. The tray and the glasses are rigid bodies of MuJoCo (see the
# scenario): tilted or shaken, the glasses fall for real. Z-up, metres,
# radians. Seen from above:
#
#                 stand_a (0.60, -0.21)         stand_b (0.60, 0.21)
#   left (0, 0) -->      tray: g1 g2               -> tray ->        <-- right (1.02, 0), on a pedestal
#                              g3 g4
#
# The rails of a stand run along y, 0.80 m high, open toward the middle:
# the cup slides between them, under the tray, from y = 0.
world:
  id: tray_cell

  entities:
    - id: left
      type: robot
      kind: arm
      model: robotik.robots.robot_6axis
      # The cup points up, below the height of the rails, between the stands.
      home: { joint1: 0.0, joint2: 0.686, joint3: 0.979, joint4: 0.0, joint5: -1.665, joint6: 0.0 }
      sensors:
        left_camera: { type: camera, parent: link6, position: [0.05, 0.0, 0.0], fov: 70,
                       resolution: [320, 240], frequency: 15 }
      actuators:
        left_arm: { type: joint_group, joints: [joint1, joint2, joint3, joint4, joint5, joint6] }
    - id: left_cup
      type: tool
      model: robotik.tools.vacuum
      attach: { parent: left.flange, frame: tool_mount }
      actuators:
        left_gripper: { type: vacuum }

    - id: right
      type: robot
      kind: arm
      model: robotik.robots.robot_6axis
      pose: { position: [1.02, 0.0, 0.55], rpy: [0.0, 0.0, 3.141592653589793] }
      # Turned aside, the drill pointing down, out of the way of the tray.
      home: { joint1: 1.2, joint2: -0.1, joint3: 1.55, joint4: 0.0, joint5: 1.69, joint6: 0.0 }
      sensors:
        right_camera: { type: camera, parent: link6, position: [0.05, 0.0, 0.0], fov: 70,
                        resolution: [320, 240], frequency: 15 }
      actuators:
        # The arm alone: the spindle of the drill is not one of its joints.
        right_arm: { type: joint_group, joints: [joint1, joint2, joint3, joint4, joint5, joint6] }
    - id: right_drill
      type: tool
      model: robotik.tools.drill
      attach: { parent: right.flange, frame: tool_mount }
      # The drill works on the tray: touching it is not a collision.
      touches: [tray]
      sensors:
        # Force received by the spindle from the drill body: the drill feels
        # the tray instead of trusting where it believes the tray is.
        right_ft: { type: force_torque, link: drill_spindle, force: 0.05, torque: 0.005 }

    # Furniture: fixed bodies of the physics.
    - id: pedestal
      type: body
      model: robotik.dual_arm.pedestal
      physics: fixed
      pose: { position: [1.02, 0.0, 0.0] }
    - id: stand_a
      type: body
      model: robotik.dual_arm.stand
      physics: fixed
      # Legs on the outer side (-y).
      pose: { position: [0.60, -0.21, 0.0], rpy: [0.0, 0.0, 3.141592653589793] }
    - id: stand_b
      type: body
      model: robotik.dual_arm.stand
      physics: fixed
      pose: { position: [0.60, 0.21, 0.0] }

    # Floor mats under the stands: the places of the planner (a body is not
    # in the beliefs, a prop is).
    - id: pad_a
      type: prop
      kind: pad
      shape: { type: container, size: [0.28, 0.28, 0.004] }
      color: [0.30, 0.30, 0.30]
      pose: { position: [0.60, -0.21, 0.002] }
    - id: pad_b
      type: prop
      kind: pad
      shape: { type: container, size: [0.28, 0.28, 0.004] }
      color: [0.30, 0.30, 0.30]
      pose: { position: [0.60, 0.21, 0.002] }

    # The tray rests on the rails of stand_a; the cup takes it at the centre
    # of its bottom face.
    - id: tray
      type: prop
      kind: tray
      shape: { type: box, size: [0.30, 0.34, 0.012] }
      color: [0.75, 0.55, 0.30]
      mass: 0.3
      friction: 1.0
      pose: { position: [0.60, -0.21, 0.806] }

    # Square glasses (boxes: the only free shape), 9 cm high, 100 g, as a
    # 2 x 2 matrix: the middle of the tray stays free for the drill.
    - id: g1
      type: prop
      shape: { type: box, size: [0.05, 0.05, 0.09] }
      color: [0.70, 0.85, 0.95]
      mass: 0.1
      friction: 1.0
      pose: { position: [0.51, -0.31, 0.857] }
    - id: g2
      type: prop
      shape: { type: box, size: [0.05, 0.05, 0.09] }
      color: [0.70, 0.85, 0.95]
      mass: 0.1
      friction: 1.0
      pose: { position: [0.51, -0.11, 0.857] }
    - id: g3
      type: prop
      shape: { type: box, size: [0.05, 0.05, 0.09] }
      color: [0.70, 0.85, 0.95]
      mass: 0.1
      friction: 1.0
      pose: { position: [0.69, -0.31, 0.857] }
    - id: g4
      type: prop
      shape: { type: box, size: [0.05, 0.05, 0.09] }
      color: [0.70, 0.85, 0.95]
      mass: 0.1
      friction: 1.0
      pose: { position: [0.69, -0.11, 0.857] }
