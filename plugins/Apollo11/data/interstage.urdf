<?xml version="1.0"?>
<!-- S-IC/S-II interstage ring, at scale -->
<robot name="interstage">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/interstage_white.stl"/></geometry>
      <material name="base_0"><color rgba="0.920 0.920 0.900 1"/></material>
    </visual>
    <inertial><mass value="5200"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
