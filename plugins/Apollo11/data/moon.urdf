<?xml version="1.0"?>
<!-- The Moon, unit sphere scaled by the plugin -->
<robot name="moon">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="1"/></geometry>
      <material name="base_0"><color rgba="0.620 0.610 0.580 1"/></material>
    </visual>
    <inertial><mass value="1"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
