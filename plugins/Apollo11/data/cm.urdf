<?xml version="1.0"?>
<!-- Command Module Columbia, docking probe on top, at scale -->
<robot name="cm">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/cm_shield.stl"/></geometry>
      <material name="base_0"><color rgba="0.420 0.320 0.220 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/cm_silver.stl"/></geometry>
      <material name="base_1"><color rgba="0.800 0.810 0.830 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/cm_probe.stl"/></geometry>
      <material name="base_2"><color rgba="0.580 0.580 0.550 1"/></material>
    </visual>
    <inertial><mass value="5600"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
