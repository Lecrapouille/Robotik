<?xml version="1.0"?>
<!-- A flat disc, 150 km wide, under a vehicle close to the ground -->
<robot name="earth_ground">
  <link name="base">
    <visual>
      <origin xyz="0 0 -10" rpy="0 0 0"/>
      <geometry><cylinder radius="150000" length="20"/></geometry>
      <material name="base_0"><color rgba="0.220 0.360 0.420 1"/></material>
    </visual>
    <inertial><mass value="1"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
