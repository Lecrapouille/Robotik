<?xml version="1.0"?>
<!-- S-II second stage, five J-2 engines, and the S-II/S-IVB interstage, at scale -->
<robot name="s_ii">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/s_ii_white.stl"/></geometry>
      <material name="base_0"><color rgba="0.920 0.920 0.900 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/s_ii_engines.stl"/></geometry>
      <material name="base_1"><color rgba="0.300 0.290 0.280 1"/></material>
    </visual>
    <inertial><mass value="39600"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
