<?xml version="1.0"?>
<!-- LM Eagle ascent stage, APS engine, docking drogue on top, at scale -->
<robot name="lm_ascent">
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lm_ascent_gray.stl"/></geometry>
      <material name="base_0"><color rgba="0.580 0.580 0.550 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lm_ascent_black.stl"/></geometry>
      <material name="base_1"><color rgba="0.080 0.080 0.090 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/lm_ascent_engine.stl"/></geometry>
      <material name="base_2"><color rgba="0.300 0.290 0.280 1"/></material>
    </visual>
    <inertial><mass value="2470"/><origin xyz="0 0 0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
