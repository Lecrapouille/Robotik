<?xml version="1.0"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-RobotIK-Commercial
     Copyright (c) 2020-2026 Quentin Quadrat
     Stand of a tray: two rails along y, open toward -y, held by two legs
     on the +y side. A cup comes under the tray between the rails.
     Base frame: origin on the floor below the middle of the rails, z up.
     The top of the rails is 0.80 m high. -->
<robot name="stand">
  <material name="aluminium"><color rgba="0.78 0.80 0.83 1"/></material>
  <material name="graphite"><color rgba="0.20 0.21 0.24 1"/></material>

  <link name="stand_base">
    <inertial>
      <origin xyz="0 0.15 0.4" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <!-- rail -->
      <origin xyz="-0.1100 0.0000 0.7900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0300 0.3000 0.0200"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <!-- rail -->
      <origin xyz="-0.1100 0.0000 0.7900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0300 0.3000 0.0200"/></geometry>
    </collision>
    <visual>
      <!-- leg -->
      <origin xyz="-0.1100 0.1700 0.3900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0400 0.0400 0.7800"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <!-- leg -->
      <origin xyz="-0.1100 0.1700 0.3900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0400 0.0400 0.7800"/></geometry>
    </collision>
    <visual>
      <!-- foot -->
      <origin xyz="-0.1100 0.2100 0.0100" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0800 0.1200 0.0200"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <!-- foot -->
      <origin xyz="-0.1100 0.2100 0.0100" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0800 0.1200 0.0200"/></geometry>
    </collision>
    <visual>
      <!-- rail -->
      <origin xyz="0.1100 0.0000 0.7900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0300 0.3000 0.0200"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <!-- rail -->
      <origin xyz="0.1100 0.0000 0.7900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0300 0.3000 0.0200"/></geometry>
    </collision>
    <visual>
      <!-- leg -->
      <origin xyz="0.1100 0.1700 0.3900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0400 0.0400 0.7800"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <!-- leg -->
      <origin xyz="0.1100 0.1700 0.3900" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0400 0.0400 0.7800"/></geometry>
    </collision>
    <visual>
      <!-- foot -->
      <origin xyz="0.1100 0.2100 0.0100" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0800 0.1200 0.0200"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <!-- foot -->
      <origin xyz="0.1100 0.2100 0.0100" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.0800 0.1200 0.0200"/></geometry>
    </collision>
    <visual>
      <!-- cross_bar -->
      <origin xyz="0.0000 0.1700 0.7800" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.2800 0.0400 0.0400"/></geometry>
      <material name="graphite"/>
    </visual>
    <collision>
      <!-- cross_bar -->
      <origin xyz="0.0000 0.1700 0.7800" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.2800 0.0400 0.0400"/></geometry>
    </collision>
    <visual>
      <!-- back_brace -->
      <origin xyz="0.0000 0.1700 0.2500" rpy="0.0000 0.0000 0.0000"/>
      <geometry><box size="0.1800 0.0300 0.0300"/></geometry>
      <material name="graphite"/>
    </visual>
  </link>
</robot>
