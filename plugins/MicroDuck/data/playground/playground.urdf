     Playground of the Microduck: a room of 2.4 m by 2.4 m with low walls,
     a sofa, a pouf, a shelf and a rug (drawn only: the duck walks on it).
     Base frame: origin on the floor at the middle of the room, z up.
     Generated once; edit the boxes here. -->
<robot name="playground">
  <material name="wood"><color rgba="0.80 0.66 0.48 1"/></material>
  <material name="rug"><color rgba="0.30 0.42 0.55 1"/></material>
  <material name="sofa"><color rgba="0.62 0.32 0.26 1"/></material>
  <material name="pouf"><color rgba="0.88 0.70 0.30 1"/></material>
  <material name="shelf"><color rgba="0.45 0.35 0.28 1"/></material>

  <link name="playground_base">
